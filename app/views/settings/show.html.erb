<% content_for :title, t("settings.title") %>
<main class="page">
  <h1><%= t("settings.title") %></h1>
  <% if flash[:notice] %><%= ui_notice :success, flash[:notice], html: { id: "settings-saved" } %><% end %>
  <p><%= t("settings.intro") %></p>
  <%# D-354: a choice applies and is saved at once (settings_controller.js posts it to the same endpoint); «Salva» stays for a browser without scripts. %>
  <%= form_with url: "#{base_path}/preferences", method: :post, class: "preferences", id: "preferences",
        data: { controller: "settings", action: "submit->settings#submit", settings_url_value: "#{base_path}/preferences", settings_saved_value: t("settings.saved_now"), settings_failed_value: t("settings.not_saved") } do %>
    <div class="card">
    <fieldset class="options choice-list" data-comment-anchor="setting:theme">
      <legend><%= t("diagnosis.preferences.theme") %></legend>
      <% Diagnosis::Preferences::THEMES.each do |theme| %>
        <label class="option choice"><%= radio_button_tag "theme", theme, @preferences[:theme] == theme, data: { action: "change->settings#choose" } %> <span><%= t("diagnosis.preferences.themes.#{theme}") %></span></label>
      <% end %>
    </fieldset>
    <p class="field-help"><%= t("diagnosis.preferences.theme_hint") %></p>
    </div>
    <div class="card">
    <fieldset class="options choice-list" data-comment-anchor="setting:size">
      <legend><%= t("diagnosis.preferences.size") %></legend>
      <% Diagnosis::Preferences::SIZES.each do |size| %>
        <label class="option choice"><%= radio_button_tag "size", size, @preferences[:size] == size, data: { action: "change->settings#choose" } %> <span><%= t("diagnosis.preferences.sizes.#{size}") %></span></label>
      <% end %>
    </fieldset>
    <p class="field-help"><%= t("diagnosis.preferences.size_hint") %></p>
    </div>
    <% unless preview? %>
    <div class="card">
    <fieldset class="options choice-list" data-comment-anchor="setting:language">
      <legend><%= t("diagnosis.preferences.language") %></legend>
      <% Diagnosis::Preferences::LANGUAGES.each do |language| %>
        <label class="option choice"><%= radio_button_tag "language", language, @preferences[:language] == language, data: { action: "change->settings#choose" } %> <span lang="<%= language %>"><%= t("diagnosis.preferences.languages.#{language}") %></span></label>
      <% end %>
    </fieldset>
    <p class="field-help"><%= t("diagnosis.preferences.language_hint") %></p>
    </div>
    <% end %>
    <div class="button-row"><button type="submit" class="button"><%= t("diagnosis.preferences.save") %></button> <span class="field-help" id="settings-status" role="status" data-settings-target="status"></span></div>
  <% end %>
  <%# the voices of this device, one sentence each (D-283): the operator listens here once, on the student's own device %>
  <section id="voci" class="voices card" data-comment-anchor="setting:voices" data-controller="voices" data-voices-labels-value="<%= t("lesson2.voices").to_json %>">
    <h2><%= t("lesson2.voices.title") %></h2>
    <p><%= t("lesson2.voices.intro") %></p>
    <div data-voices-target="list"></div>
  </section>
  <%# D-357: one line to the two information pages; the form above is not touched. %>
  <p class="hint" id="settings-info-links"><%= link_to t("privacy.settings_links.account"), "/account" %> · <%= link_to t("privacy.settings_links.privacy"), "/privacy" %></p>
</main>

<% content_for :title, t("settings.title") %>
<main class="page">
  <h1><%= t("settings.title") %></h1>
  <% if flash[:notice] %><p class="notice" id="settings-saved" role="status"><%= flash[:notice] %></p><% end %>
  <p><%= t("settings.intro") %></p>
  <%= form_with url: "/diagnosis/preferences", method: :post, class: "preferences", id: "preferences" do %>
    <fieldset class="options choice-list" data-comment-anchor="setting:theme">
      <legend><%= t("diagnosis.preferences.theme") %></legend>
      <% Diagnosis::Preferences::THEMES.each do |theme| %>
        <label class="option choice"><%= radio_button_tag "theme", theme, @preferences[:theme] == theme %> <span><%= t("diagnosis.preferences.themes.#{theme}") %></span></label>
      <% end %>
    </fieldset>
    <fieldset class="options choice-list" data-comment-anchor="setting:size">
      <legend><%= t("diagnosis.preferences.size") %></legend>
      <% Diagnosis::Preferences::SIZES.each do |size| %>
        <label class="option choice"><%= radio_button_tag "size", size, @preferences[:size] == size %> <span><%= t("diagnosis.preferences.sizes.#{size}") %></span></label>
      <% end %>
    </fieldset>
    <p><button type="submit" class="button"><%= t("diagnosis.preferences.save") %></button></p>
  <% end %>
  <%# the voices of this device, one sentence each (D-283): the operator listens here once, on the student's own device %>
  <section id="voci" class="voices" data-comment-anchor="setting:voices" data-controller="voices" data-voices-labels-value="<%= t("lesson2.voices").to_json %>">
    <h2><%= t("lesson2.voices.title") %></h2>
    <p><%= t("lesson2.voices.intro") %></p>
    <div data-voices-target="list"></div>
  </section>
</main>

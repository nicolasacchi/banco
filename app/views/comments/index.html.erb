<% content_for :title, t("comments.title") %>
<main class="page course cm-page" data-comment-anchor="page">
  <div class="cm-shell" data-view="list">
    <%= render "comments/list", inbox: @inbox, current: nil, heading: "h1" %>
    <section class="cm-thread-pane cm-thread-none" aria-hidden="true">
      <%= comment_icon("comment") %>
      <p><%= t("comments.thread.pick") %></p>
    </section>
  </div>
</main>

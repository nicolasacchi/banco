<% content_for :title, @topic.title_it %>
<% skill_states = @topic.skills.map { |skill| course_view.state(skill) } %>
<% done_count = skill_states.count { |s| Practice::Today::DONE.include?(s.state) } %>
<main class="page course topic-page" style="--subject: var(--accent-<%= @subject_view.subject.key %>, var(--soft-primary))">
  <%= ui_page_header(@topic.title_it, back: [ @subject_view.subject.name_it, spath("/subjects/#{@subject_view.subject.key}") ]) %>
  <p class="topic-meta cluster">
    <%= subject_chip(@subject_view.subject.key) %>
    <span><%= t("topic.kind.#{@topic.kind}") %></span>
    <%= ui_tag(t("topic.minutes", n: @topic.minutes), icon: "clock-minutes") %>
  </p>
  <% if draft? %><%= ui_notice :info, t("draft.notice"), html: { id: "draft-notice" } %><% end %>
  <% if @programme.any? %>
    <section class="programme-box" aria-label="<%= t("topic.programme_title") %>">
      <ul class="plain" id="programme">
        <% @programme.each do |ref| %><li><%= t("topic.programme", line: ref["line"], fragment: ref["fragment"]) %></li><% end %>
      </ul>
    </section>
  <% end %>
  <% if @intro %><p id="intro"><%= @intro %></p><% end %>

  <ol class="topic-steps" aria-label="<%= t("topic.steps") %>">
    <li class="topic-step card<%= ' action' unless @read %>" id="step-lesson" data-state="<%= @read ? 'done' : 'todo' %>">
      <div class="step-head">
        <span class="step-number" aria-hidden="true">1</span>
        <h2 class="card-title"><%= ui_icon("step-lesson") %> <%= t("topic.step_lesson") %></h2>
        <% if @read %>
          <span class="pill success" id="lesson-read"><%= ui_icon("check") %><%= t("topic.lesson_read") %></span>
        <% else %>
          <%= ui_pill(t("topic.lesson_unread"), :muted) %>
        <% end %>
      </div>
      <a class="button<%= ' secondary' if @read %>" id="lesson-link" href="<%= spath("/topics/#{@topic.key}/lesson") %>"><%= t("topic.lesson") %></a>
    </li>
    <li class="topic-step card" id="step-practice" data-state="<%= done_count == skill_states.size && skill_states.any? ? 'done' : 'todo' %>">
      <div class="step-head">
        <span class="step-number" aria-hidden="true">2</span>
        <h2 class="card-title"><%= ui_icon("step-practice") %> <%= t("topic.step_practice") %></h2>
        <% if skill_states.any? %>
          <%= ui_pill(t("topic.practice_progress", done: done_count, total: skill_states.size), done_count == skill_states.size ? :success : (done_count.positive? ? :info : :muted)) %>
        <% end %>
      </div>
      <p class="muted"><%= t("topic.step_practice_hint") %></p>
      <ul class="skills topic-skills" id="skills" aria-label="<%= t("topic.skills") %>">
        <% @topic.skills.each do |skill| %>
          <% state = course_view.state(skill) %>
          <li class="skill" data-skill="<%= skill %>" data-state="<%= state.state %>">
            <div class="skill-main">
              <span class="skill-name"><%= course_view.label(skill) %></span>
              <span class="topic-why"><%= Practice::Messages.why_it(state.why) %></span>
            </div>
            <div class="skill-side">
              <span class="topic-meta"><%= ui_pill(Practice::Messages.state_it(state.state), skill_state_tone(state.state)) %></span>
              <a class="button small" href="<%= spath("/topics/#{@topic.key}/practice/#{skill}") %>"><%= t("topic.practise") %></a>
            </div>
          </li>
        <% end %>
      </ul>
    </li>
  </ol>
  <%= render "course/question", topic: @topic.key, lesson_revision_id: @topic.lesson_revision.id %>
</main>

<% content_for :title, @topic.title_it %>
<main class="page course">
  <p><a href="/subjects/<%= @subject_view.subject.key %>"><%= t("topic.to_subject") %></a></p>
  <h1><%= @topic.title_it %></h1>
  <p class="topic-meta"><%= t("topic.kind.#{@topic.kind}") %> · <%= t("topic.minutes", n: @topic.minutes) %></p>
  <% if draft? %><p class="notice" id="draft-notice" role="status"><%= t("draft.notice") %></p><% end %>
  <% if @programme.any? %>
    <ul class="plain" id="programme">
      <% @programme.each do |ref| %><li><%= t("topic.programme", line: ref["line"], fragment: ref["fragment"]) %></li><% end %>
    </ul>
  <% end %>
  <% if @intro %><p id="intro"><%= @intro %></p><% end %>
  <p><a class="button" id="lesson-link" href="/topics/<%= @topic.key %>/lesson"><%= t("topic.lesson") %></a>
    <% if @read %><span class="topic-meta" id="lesson-read"><%= t("topic.lesson_read") %></span><% end %></p>
  <h2><%= t("topic.skills") %></h2>
  <ul class="skills" id="skills">
    <% @topic.skills.each do |skill| %>
      <% state = course_view.state(skill) %>
      <li class="skill" data-skill="<%= skill %>" data-state="<%= state.state %>">
        <span class="skill-name"><%= course_view.label(skill) %></span>
        <span class="topic-meta"><%= Practice::Messages.state_it(state.state) %></span>
        <span class="topic-why"><%= Practice::Messages.why_it(state.why) %></span>
        <a class="button" href="/topics/<%= @topic.key %>/practice/<%= skill %>"><%= t("topic.practise") %></a>
      </li>
    <% end %>
  </ul>
  <%= render "course/question", topic: @topic.key, lesson_revision_id: @topic.lesson_revision.id %>
</main>

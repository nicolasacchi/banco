<%# «Scrivi tu» (D-407): the writing tasks of the topic, after the exercises. A task is not an exercise: no try, no skill, no part of the topic's completion. writing_controller.js is the
    whole behaviour (draft in localStorage, live word count, «Consegna» through its own outbox); the server draws the state he is in: not written, sent, corrected. Locals: block (Writings::StudentBlock), topic. %>
<section id="writing" class="topic-writing" aria-labelledby="writing-title" data-comment-anchor="writing">
  <h2 id="writing-title" class="card-title"><%= t("writing.title") %></h2>
  <p class="muted"><%= t("writing.intro") %></p>
  <% block.tasks.each_with_index do |task, i| %>
    <% latest = task.latest %>
    <% correction = latest&.correction %>
    <article class="card writing-task" id="writing-<%= i + 1 %>" data-writing-task="<%= task.item_key %>" data-state="<%= task.state %>" data-comment-anchor="writing:<%= i + 1 %>"
             data-controller="writing" data-writing-url-value="<%= spath("/topics/#{topic.key}/writings") %>" data-writing-item-revision-value="<%= task.revision.id %>"
             data-writing-item-key-value="<%= task.item_key %>" data-writing-preview-value="<%= preview? %>" data-writing-last-value="<%= latest&.submission&.text %>"
             data-writing-labels-value="<%= writing_labels.to_json %>">
      <p class="writing-stem" id="writing-<%= i + 1 %>-stem" <%= tag.attributes(lang: task.lang) if task.lang %>><%= task.stem %></p>
      <%= tr_node(task.stem_tr, tag: :p) if task.stem_tr %>
      <p class="writing-range"><%= t("writing.words", min: task.words_min, max: task.words_max) %></p>

      <form class="writing-form" data-writing-target="form" data-action="submit->writing#send" novalidate<%= " hidden" unless task.state == :new %>>
        <label for="writing-<%= i + 1 %>-text"><%= t("writing.label") %></label>
        <textarea id="writing-<%= i + 1 %>-text" class="answer-input wide" rows="10" maxlength="<%= WritingSubmission::TEXT_MAX %>" aria-describedby="writing-<%= i + 1 %>-count"
                  <%= tag.attributes(lang: task.lang) if task.lang %> data-writing-target="text" data-action="input->writing#input"></textarea>
        <p class="writing-meta"><span id="writing-<%= i + 1 %>-count" data-writing-target="count"></span> · <span data-writing-target="chars"></span></p>
        <p class="hint"><%= t("writing.draft_kept") %></p>
        <p class="writing-status" role="status" data-writing-target="status"></p>
        <div class="button-row">
          <button type="submit" class="button" data-writing-target="send"><%= t("writing.send") %></button>
          <button type="button" class="button secondary" data-writing-target="cancel" data-action="writing#cancel" hidden><%= t("writing.cancel") %></button>
        </div>
      </form>

      <div class="writing-sent" data-writing-target="sent"<%= " hidden" if task.state == :new %>>
        <p class="writing-note" role="status" tabindex="-1" data-writing-target="note"><%= task.state == :corrected ? t("writing.your_text") : t("writing.sent") %></p>
        <p class="writing-text" data-writing-target="sentText" <%= tag.attributes(lang: task.lang) if task.lang %>><%= latest&.submission&.text %></p>
        <div class="writing-correction" data-writing-target="correction"<%= " hidden" unless correction %>>
          <h3><%= t("writing.correction") %></h3>
          <p class="writing-correction-text" data-writing-correction><%= correction&.text_it %></p>
        </div>
        <button type="button" class="button" data-writing-target="again" data-action="writing#again"<%= " hidden" unless correction %>><%= t("writing.again") %></button>
      </div>

      <% earlier = task.versions.drop(1) %>
      <% if earlier.any? %>
        <details class="writing-versions">
          <summary><%= t("writing.versions", n: earlier.size) %></summary>
          <% earlier.each_with_index do |version, j| %>
            <div class="writing-version" data-version="<%= earlier.size - j %>">
              <h3><%= t("writing.version", n: earlier.size - j) %></h3>
              <p class="writing-text"><%= version.submission.text %></p>
              <% if version.correction %>
                <h4><%= t("writing.correction") %></h4>
                <p class="writing-correction-text"><%= version.correction.text_it %></p>
              <% else %>
                <p class="hint"><%= t("writing.not_corrected") %></p>
              <% end %>
            </div>
          <% end %>
        </details>
      <% end %>
    </article>
  <% end %>
</section>

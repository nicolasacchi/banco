<% content_for :title, t("diagnosis.title") %>
<main class="page">
  <h1><%= t("diagnosis.title") %></h1>
  <% if @released %>
    <p><%= t("diagnosis.order_line") %></p>
    <ul class="subjects">
      <% @rows.each do |row| %>
        <li class="subject<%= ' suggested' if row.suggested %>" data-subject="<%= row.subject.key %>" data-state="<%= row.status %>">
          <span class="subject-name"><%= row.subject.name_it %></span>
          <span class="subject-state"><%= t(row.label_key, **row.label_args) %></span>
          <% if row.done %>
            <% if row.run_id %>
              <a class="button secondary" href="/diagnosis/runs/<%= row.run_id %>/results"><%= t("diagnosis.actions.results") %></a>
            <% end %>
          <% elsif row.startable %>
            <%= button_to (%w[in_progress continue_next_day].include?(row.status) ? t("diagnosis.actions.resume") : t("diagnosis.actions.start")),
                          "/diagnosis/subjects/#{row.subject.key}", class: "button", form: { class: "inline" } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="notice"><%= t("diagnosis.not_open") %></p>
    <% if @warmup_done %>
      <p><%= t("diagnosis.not_open_warmup_done") %></p>
    <% else %>
      <p><%= t("diagnosis.not_open_warmup") %></p>
    <% end %>
    <p><a class="button" href="/diagnosis/warmup"><%= t("diagnosis.warmup_link") %></a></p>
  <% end %>
  <% prefs = ui_preferences %>
  <h2><%= t("diagnosis.preferences.title") %></h2>
  <%= form_with url: "/diagnosis/preferences", method: :post, class: "preferences" do %>
    <fieldset class="options">
      <legend><%= t("diagnosis.preferences.theme") %></legend>
      <% Diagnosis::Preferences::THEMES.each do |theme| %>
        <label class="option"><%= radio_button_tag "theme", theme, prefs[:theme] == theme %> <span><%= t("diagnosis.preferences.themes.#{theme}") %></span></label>
      <% end %>
    </fieldset>
    <fieldset class="options">
      <legend><%= t("diagnosis.preferences.size") %></legend>
      <% Diagnosis::Preferences::SIZES.each do |size| %>
        <label class="option"><%= radio_button_tag "size", size, prefs[:size] == size %> <span><%= t("diagnosis.preferences.sizes.#{size}") %></span></label>
      <% end %>
    </fieldset>
    <p><button type="submit" class="button secondary"><%= t("diagnosis.preferences.save") %></button></p>
  <% end %>
</main>

<% content_for :title, t("search.title") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "lesson_roles" %>
  <%= stylesheet_link_tag "search" %>
<% end %>
<main class="page search-page" id="search-page">
  <h1><%= t("search.title") %></h1>
  <%# A plain GET form: no script. The browser's own clear control (type=search) and the "Cancella" link empty the box. %>
  <form action="/search" method="get" role="search" class="search-form" id="search-form" autocomplete="off">
    <label for="search-q" class="search-label"><%= t("search.label") %></label>
    <div class="search-row">
      <input type="search" id="search-q" name="q" value="<%= @query %>" maxlength="<%= SearchController::MAX_QUERY %>" class="search-input"
             placeholder="<%= t("search.placeholder") %>" autofocus enterkeyhint="search">
      <button type="submit" class="button"><%= t("search.submit") %></button>
      <% if @query.present? %><a href="/search" class="button secondary" id="search-clear"><%= t("search.clear") %></a><% end %>
    </div>
  </form>

  <% if @query.blank? %>
    <p class="hint" id="search-hint"><%= t("search.hint") %></p>
  <% elsif !@result.indexed %>
    <p class="notice" id="search-not-ready" role="status"><%= t("search.not_ready") %></p>
  <% elsif @result.hits.empty? %>
    <p id="search-empty" role="status"><%= t("search.empty") %></p>
  <% else %>
    <p class="hint" id="search-count" role="status"><%= t("search.count", count: @result.hits.size) %></p>
    <% @groups.each do |kind, hits| %>
      <section class="search-group" data-kind="<%= kind %>" aria-labelledby="search-group-<%= kind %>">
        <h2 id="search-group-<%= kind %>"><%= search_icon(kind) %> <%= search_kind_name(kind) %></h2>
        <ul class="search-hits">
          <% hits.each do |hit| %>
            <% href = Search::Links.student(hit, @scope.practice_targets) %>
            <li class="search-hit" data-subject="<%= hit.subject %>" style="<%= search_accent_style(hit.subject) %>">
              <p class="search-subject"><%= search_subject_name(hit.subject) %></p>
              <% if href %><a class="search-title" href="<%= href %>"><%= hit.title %></a><% else %><span class="search-title"><%= hit.title %></span><% end %>
              <% if kind == "glossary_term" %>
                <details class="search-definition">
                  <summary><%= t("search.definition") %></summary>
                  <p><%= hit.body %></p>
                </details>
              <% else %>
                <p class="search-snippet"><%= search_snippet(hit, @result) %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
</main>

<% content_for :title, @subject_view.subject.name_it %>
<% key = @subject_view.subject.key %>
<main class="page course" style="--subject: var(--accent-<%= key %>, var(--soft-primary))">
  <%= ui_page_header(@subject_view.subject.name_it, back: [ t("subjects.title"), spath("/subjects") ]) %>
  <section class="card subject-summary" aria-label="<%= t("subjects.title") %>">
    <div class="subject-line">
      <%= subject_chip(key) %>
      <div class="subject-text"><%= render "course/progress", progress: subject_progress(course_view.counts(@subject_view)) %></div>
    </div>
  </section>
  <% if @without_topic.any? %>
    <%= ui_notice :info, t("subject.no_topic", skills: @without_topic.map { |s| course_view.label(s) }.join(", ")), html: { id: "without-topic" } %>
  <% end %>
  <h2><%= t("subject.topics") %></h2>
  <ol class="topics topic-list" id="topics">
    <% @subject_view.topics.each_with_index do |topic, i| %>
      <% status = course_view.status(topic); before = course_view.before(@subject_view, topic) %>
      <li class="topic row" data-topic="<%= topic.key %>" data-status="<%= status %>">
        <span class="topic-number" aria-hidden="true"><%= i + 1 %></span>
        <div class="row-main">
          <a class="topic-title row-stretch" href="<%= spath("/topics/#{topic.key}") %>"><%= topic.title_it %></a>
          <span class="topic-meta"><%= t("topic.kind.#{topic.kind}") %> · <%= t("topic.minutes", n: topic.minutes) %></span>
          <% if before %><span class="topic-why"><%= t("topic.before", topic: before.title_it) %></span><% end %>
          <% unless topic.approved %><span class="topic-why"><%= ui_tag(t("topic.draft")) %> <%= t("draft.notice") %></span><% end %>
        </div>
        <span class="row-end">
          <% if course_view.recover_tag?(topic) %><%= ui_pill(t("topic.tag_recover"), :nearly) %><% end %>
          <%= ui_pill(t("topic.status.#{status}"), topic_status_tone(status)) %>
          <%= ui_icon("next", css: "row-chev") %>
        </span>
      </li>
    <% end %>
  </ol>
</main>

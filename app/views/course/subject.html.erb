<% content_for :title, @subject_view.subject.name_it %>
<main class="page course">
  <h1><%= @subject_view.subject.name_it %></h1>
  <p class="counts"><%= t("subjects.counts", **course_view.counts(@subject_view)) %></p>
  <% if @without_topic.any? %>
    <p id="without-topic"><%= t("subject.no_topic", skills: @without_topic.map { |s| course_view.label(s) }.join(", ")) %></p>
  <% end %>
  <h2><%= t("subject.topics") %></h2>
  <ol class="topics" id="topics">
    <% @subject_view.topics.each do |topic| %>
      <% status = course_view.status(topic); before = course_view.before(@subject_view, topic) %>
      <li class="topic" data-topic="<%= topic.key %>" data-status="<%= status %>">
        <a class="topic-title" href="/topics/<%= topic.key %>"><%= topic.title_it %></a>
        <span class="topic-meta"><%= t("topic.kind.#{topic.kind}") %> · <%= t("topic.minutes", n: topic.minutes) %> · <%= t("topic.status.#{status}") %><%= " · #{t('topic.tag_recover')}" if course_view.recover_tag?(topic) %></span>
        <% if before %><span class="topic-why"><%= t("topic.before", topic: before.title_it) %></span><% end %>
        <% unless topic.approved %><span class="topic-why"><%= t("draft.notice") %></span><% end %>
      </li>
    <% end %>
  </ol>
</main>

<% content_for :title, t("today.title") %>
<main class="page course">
  <h1><%= t("today.title") %></h1>
  <% if @nothing %>
    <p class="notice" id="course-closed"><%= t("today.closed") %></p>
  <% end %>
  <% if @diagnosis %>
    <% d = @diagnosis %>
    <section id="entry-test" aria-labelledby="entry-test-title" data-state="<%= d[:open] ? (d[:all_done] ? 'done' : 'open') : 'closed' %>">
      <h2 id="entry-test-title"><%= t(@diagnosis[:open] ? "today.entry.title" : "today.entry.title_warmup") %></h2>
      <% unless d[:open] %>
        <p><%= t("today.entry.not_open") %></p>
      <% end %>
      <% unless d[:warmup_done] %>
        <p id="entry-warmup"><%= t("today.entry.warmup") %></p>
        <p><a class="button<%= ' secondary' if d[:open] && d[:next_row] %>" href="/diagnosis/warmup"><%= t("diagnosis.warmup_link") %></a></p>
      <% end %>
      <% if d[:open] %>
        <% if d[:all_done] %>
          <p id="entry-all-done"><%= t("today.entry.all_done") %></p>
        <% end %>
        <ul class="subjects" id="entry-subjects">
          <% d[:rows].each do |row| %>
            <% next_one = row.equal?(d[:next_row]) %>
            <li class="subject<%= ' suggested' if next_one %>" data-subject="<%= row.subject.key %>" data-state="<%= row.status %>">
              <span class="subject-name"><%= row.subject.name_it %></span>
              <span class="subject-state"><%= t(row.label_key, **row.label_args) %></span>
              <% if next_one %>
                <%= button_to (%w[in_progress continue_next_day].include?(row.status) ? t("diagnosis.actions.resume") : t("diagnosis.actions.start")),
                              "/diagnosis/subjects/#{row.subject.key}", class: "button", id: "entry-next", form: { class: "inline" } %>
              <% elsif row.done && row.run_id %>
                <a class="button secondary" href="/diagnosis/runs/<%= row.run_id %>/results"><%= t("diagnosis.actions.results") %></a>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
  <% if @course_open %>
    <section id="course-part" aria-labelledby="course-part-title">
      <h2 id="course-part-title"><%= t("today.suggestions") %></h2>
      <% if @resume %>
        <p><a class="button" id="resume" href="<%= @resume_card ? "/topics/#{@resume[1].key}/lesson#scheda-#{@resume_card}" : "/topics/#{@resume[1].key}" %>"><%= t("today.resume", topic: @resume[1].title_it) %></a></p>
      <% end %>
      <% if @suggestions.empty? %>
        <p><%= t("today.nothing") %></p>
      <% else %>
        <ul class="topics" id="suggestions">
          <% @suggestions.each do |row| %>
            <% topic = row[:topic]; s = row[:suggestion] %>
            <li class="topic" data-topic="<%= topic.key %>" data-reason="<%= s.reason %>">
              <a class="topic-title" href="/topics/<%= topic.key %>"><%= topic.title_it %></a>
              <span class="topic-meta"><%= row[:subject_view].subject.name_it %> · <%= t("topic.kind.#{topic.kind}") %> · <%= t("topic.minutes", n: topic.minutes) %></span>
              <% if s.skill %>
                <span class="topic-why"><%= t("today.reason.#{s.reason}", skill: course_view.label(s.skill)) %></span>
              <% else %>
                <span class="topic-why"><%= t("today.reason.#{s.reason}") %></span>
              <% end %>
              <% unless topic.approved %><span class="topic-why"><%= t("draft.notice") %></span><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</main>

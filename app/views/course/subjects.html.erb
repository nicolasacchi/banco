<% content_for :title, t("subjects.title") %>
<main class="page course">
  <h1><%= t("subjects.title") %></h1>
  <% if @closed %>
    <%= ui_notice :info, t("today.closed"), html: { id: "course-closed" } %>
  <% else %>
    <ul class="subjects subject-list cards" id="subjects">
      <% @subjects.each do |sv| %>
        <% progress = subject_progress(course_view.counts(sv)) %>
        <li class="subject card subject-card" data-subject="<%= sv.subject.key %>" style="--subject: var(--accent-<%= sv.subject.key %>, var(--soft-primary))">
          <div class="subject-line">
            <%= subject_chip(sv.subject.key) %>
            <div class="subject-text">
              <a class="subject-name row-stretch" href="<%= spath("/subjects/#{sv.subject.key}") %>"><%= sv.subject.name_it %></a>
            </div>
            <%= ui_icon("next", css: "row-chev") %>
          </div>
          <%= render "course/progress", progress: progress %>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>

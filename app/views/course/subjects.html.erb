<% content_for :title, t("subjects.title") %>
<main class="page course">
  <h1><%= t("subjects.title") %></h1>
  <% if @closed %>
    <%= ui_notice :info, t("today.closed"), html: { id: "course-closed" } %>
  <% else %>
    <ul class="subjects subject-list cards" id="subjects">
      <% @subjects.each do |sv| %>
        <li class="subject card subject-card" data-subject="<%= sv.subject.key %>" style="--subject: var(--accent-<%= sv.subject.key %>, var(--soft-primary))">
          <div class="subject-line">
            <%= subject_chip(sv.subject.key) %>
            <div class="subject-text">
              <a class="subject-name row-stretch" href="<%= spath("/subjects/#{sv.subject.key}") %>"><%= sv.subject.name_it %></a>
            </div>
            <%= ui_icon("next", css: "row-chev") %>
          </div>
          <%= render "course/summary", subject_view: sv, results: false %>
        </li>
      <% end %>
      <%# Educazione civica (D-345): a view over topics of other subjects, mandatory (D-354) but never counted in a subject's progress nor in Oggi. %>
      <% if @civics.any? %>
        <li class="subject card subject-card civics-card" id="civics-card" data-civics="true" style="--subject: var(--accent-civics, var(--soft-primary))">
          <div class="subject-line">
            <%= subject_chip("civics") %>
            <div class="subject-text">
              <a class="subject-name row-stretch" href="<%= spath("/civics") %>"><%= t("civics.title") %></a>
            </div>
            <%= ui_icon("next", css: "row-chev") %>
          </div>
          <ul class="progress-lines">
            <li class="progress-line" data-line="civics">
              <span class="progress-text"><%= ui_pill(t("civics.badge"), :muted) %> <%= t("civics.card_line") %></span>
              <span class="progress-text" data-civics-count><%= t("civics.count", count: @civics.topic_count) %></span>
            </li>
          </ul>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>

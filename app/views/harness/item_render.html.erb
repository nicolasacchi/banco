<%# The render host of one instance of an item revision (D-336): what Chrome loads to draw it as the student's phone does. Same CSS, same importmap and
    same templates as the student's pages; the item is Diagnosis::ItemPresenter's projection (no key, no hint, no solution) in the frame of the page
    the student meets it in (the practice page for a practice item, the sitting page for the entry test's), unanswered, buttons as they stand before
    an answer. Nothing here connects anywhere (Validation::Harness::ITEM_CSP). items/render_host.js exposes window.bancoItemRender. The importmap is
    inline and nothing is preloaded (as the lesson host, D-335). %>
<!DOCTYPE html>
<html lang="it" data-theme="<%= @theme %>" data-size="normal">
  <head>
    <title>render</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= stylesheet_link_tag :app %>
    <link rel="stylesheet" href="/vendor/katex@0.19.0/katex.min.css">
    <%= javascript_inline_importmap_tag(student_importmap.to_json(resolver: self)) %>
    <%= javascript_import_module_tag "items/render_host" %>
  </head>
  <body class="student">
    <% if @frame == "practice" %>
      <main class="page course practice">
        <div class="card exercise-card">
          <section aria-label="<%= t("practice.exercise") %>" data-practice-target="work">
            <div class="item" id="item-box" data-comment-anchor="exercise"></div>
            <div class="actions button-row sticky-actions" data-practice-target="controls">
              <button type="button" class="button" id="check"><%= t("practice.submit") %></button>
              <% if @hints.positive? %><button type="button" class="button secondary" id="hint-button"><%= t("practice.hint", n: 1, total: @hints) %></button><% end %>
              <button type="button" class="button text" id="solution-button"><%= t("practice.solution") %></button>
            </div>
          </section>
        </div>
      </main>
    <% elsif @frame == "writing" %>
      <%# A writing task (D-407, D-410): «Scrivi tu» as the topic page draws it: the task text, its answer format and the word range (topics/_writing_prompt, the same partial),
          then the empty box and «Consegna». No «Non lo so», no «Come si risponde»: nothing is graded. The static form stands where writing_controller.js draws nothing more. %>
      <main class="page course topic-page">
        <section class="topic-writing">
          <h2 class="card-title"><%= t("writing.title") %></h2>
          <article class="card writing-task">
            <div id="item-box" data-frame="writing" data-comment-anchor="writing">
              <%= render "topics/writing_prompt", prompt: @prompt, id: "writing-1" %>
            </div>
            <div class="writing-form">
              <label for="writing-1-text"><%= t("writing.label") %></label>
              <textarea id="writing-1-text" class="answer-input wide" rows="10" <%= tag.attributes(lang: @prompt.lang) if @prompt.lang %>></textarea>
              <p class="writing-meta"><%= t("writing.words_other", count: 0) %> · <%= t("writing.chars", n: 0, max: WritingSubmission::TEXT_MAX) %></p>
              <p class="hint"><%= t("writing.draft_kept") %></p>
              <div class="button-row"><button type="button" class="button"><%= t("writing.send") %></button></div>
            </div>
          </article>
        </section>
      </main>
    <% else %>
      <main class="page">
        <section>
          <header class="bar sitting-head"><h1><%= t("sitting.header", subject: "Materia", number: 1) %></h1></header>
          <div class="card sitting-card">
            <div class="item" id="item-box" data-comment-anchor="question"></div>
            <details class="help disclosure" id="answer-help" data-comment-anchor="help">
              <summary><%= t("sitting.help.title") %></summary>
            </details>
            <div class="actions button-row sticky-actions">
              <button type="button" class="button"><%= t("sitting.send") %></button>
              <button type="button" class="button secondary"><%= t("sitting.dont_know") %></button>
            </div>
          </div>
        </section>
      </main>
    <% end %>
    <script type="application/json" id="item-presentation"><%= json_escape(@item.to_json).html_safe %></script>
    <script type="application/json" id="item-config"><%= json_escape(@config.to_json).html_safe %></script>
  </body>
</html>

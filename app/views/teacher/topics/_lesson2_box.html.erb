<%# "Come lo vede lo studente" (A14): the student's renderer in a box whose width, theme and text size the teacher
    picks, live (cards, navigation, step reveal, checks graded by a teacher-only endpoint that records nothing,
    seed "preview"). "Modalità docente" opens every "more", shows answers and solutions from full.json.
    Locals: revision (the lesson revision), topic (key); optional findings (LessonFindings entries), which need
    review (Teacher::TopicReview, which names the cards). %>
<% body = Lessons::StudentBody.for(revision, seed: "preview") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "lesson_roles" %>
  <%= stylesheet_link_tag "lesson" %>
  <%= stylesheet_link_tag "lesson/checks" %>
  <%= stylesheet_link_tag "lesson/text" %>
  <%= lesson_family_stylesheets(body) %>
<% end %>
<div class="l2-box-wrap" data-controller="lesson2-preview"
     data-lesson2-preview-revision-id-value="<%= revision.id %>"
     data-lesson2-preview-topic-value="<%= topic %>"
     data-lesson2-preview-labels-value="<%= lesson2_texts.to_json %>"
     data-lesson2-preview-items-value="<%= lesson2_item_texts.to_json %>">
  <% if search_similar_enabled? %>
    <details class="similar-line" id="similar-line">
      <summary><%= t("teacher.search.similar") %></summary>
      <ul class="plain">
        <li><a href="<%= search_similar_path("lesson_card:#{revision.lesson.key}") %>" data-similar="lesson_card:<%= revision.lesson.key %>"><%= t("teacher.search.similar_lesson") %></a></li>
        <% Array(body["cards"]).each do |card| %>
          <li><a href="<%= search_similar_path("lesson_card:#{revision.lesson.key}#scheda-#{card['n']}") %>" data-similar="lesson_card:<%= revision.lesson.key %>#scheda-<%= card['n'] %>"><%= t("teacher.search.similar_card", n: card["n"], title: card["title_it"]) %></a></li>
        <% end %>
      </ul>
    </details>
  <% end %>
  <% line = LessonRenders.teacher_line(revision) %>
  <div class="render-line" id="render-line" data-render-state="<%= line[:state] %>" role="status">
    <strong><%= t("teacher.render.label") %>:</strong>
    <% if line[:state] == "passed" %>
      <%= t("teacher.render.ok", count: line[:count]) %>
      <a href="<%= teacher_lesson_shots_path(lesson_revision_id: revision.id) %>"><%= t("teacher.render.page") %></a>
    <% elsif line[:state] == "failed" %>
      <%= t("teacher.render.failed", count: line[:cards].sum { |c| c[:errors].size }) %>
      <ul class="plain render-errors">
        <% line[:cards].each do |entry| %>
          <li>
            <% if entry[:n] && entry[:n] > 0 %>
              <a href="#card-<%= entry[:n] %>" data-action="lesson2-preview#goto" data-card="<%= entry[:n] %>"><%= t("teacher.render.card_link", n: entry[:n], title: entry[:title_it]) %></a>
            <% elsif entry[:n] == 0 %>
              <a href="#card-0" data-action="lesson2-preview#goto" data-card="0"><%= t("teacher.render.cover") %></a>
            <% else %>
              <%= t("teacher.render.whole") %>
            <% end %>
            <%= safe_join(entry[:errors].map { |e| t("teacher.render.codes.#{e['code']}", default: e["code"]) }.uniq, ", ") %>
          </li>
        <% end %>
      </ul>
      <a href="<%= teacher_lesson_shots_path(lesson_revision_id: revision.id) %>"><%= t("teacher.render.page") %></a>
    <% elsif line[:state] == "error" %>
      <%= t("teacher.render.error") %>
    <% else %>
      <%= t("teacher.render.pending") %>
    <% end %>
  </div>
  <% pins = Pages::Pins.of_lesson(revision).select { |pin| pin[:revision] } %>
  <% if pins.any? %>
    <div class="render-line" id="pages-line" role="status">
      <strong><%= t("teacher.pages.line.label") %>:</strong>
      <ul class="plain">
        <% pins.each do |pin| %>
          <% page_revision = pin[:revision]; verdict = page_revision.latest_validation %>
          <li data-page="<%= page_revision.page.key %>" data-state="<%= verdict&.status || 'pending' %>">
            <%= page_revision.manifest["title_it"] %>:
            <%= t("teacher.pages.line.#{verdict&.status || 'pending'}", kit: verdict&.kit_version, reviews: page_revision.reviews.size) %>
            <% if verdict %><a href="<%= teacher_page_shots_path(page_revision_id: page_revision.id) %>"><%= t("teacher.pages.line.shots") %></a><% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% findings = local_assigns.fetch(:findings, []) %>
  <% if findings.any? %>
    <%# D-313: the findings of the lesson review by card, each with whether the author answered; the full text is in the findings step. %>
    <div class="render-line" id="findings-line" role="status">
      <strong><%= t("teacher.topic.review.box_label") %>:</strong>
      <ul class="plain">
        <% findings.each do |entry| %>
          <li data-box-finding="<%= entry.id %>" data-severity="<%= entry.severity %>" data-answered="<%= !entry.response.nil? %>">
            <% if entry.card %><a href="#card-<%= entry.card %>" data-action="lesson2-preview#goto" data-card="<%= entry.card %>"><%= local_assigns.fetch(:review).finding_place(entry) %></a> ·<% end %>
            <%= t("teacher.skill.severity.#{entry.severity}") %> ·
            <%= entry.response ? t("teacher.topic.review.box_answered") : t("teacher.topic.review.box_open") %> ·
            <a href="#lesson-finding-<%= entry.id %>"><%= t("teacher.topic.review.box_read") %></a>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="l2-box-tools">
    <fieldset><legend><%= t("lesson2.box.width") %></legend>
      <% [ 390, 768, 1280 ].each do |w| %>
        <label><input type="radio" name="box-width-<%= revision.id %>" value="<%= w %>" <%= "checked" if w == 1280 %> data-action="lesson2-preview#width"> <%= w %></label>
      <% end %>
    </fieldset>
    <fieldset><legend><%= t("lesson2.settings_labels.theme") %></legend>
      <% t("lesson2.themes").each do |key, label| %>
        <label><input type="radio" name="box-theme-<%= revision.id %>" value="<%= key %>" <%= "checked" if key == :cream %> data-action="lesson2-preview#theme"> <%= label %></label>
      <% end %>
    </fieldset>
    <fieldset><legend><%= t("lesson2.settings_labels.size") %></legend>
      <% t("lesson2.sizes").each do |key, label| %>
        <label><input type="radio" name="box-size-<%= revision.id %>" value="<%= key %>" <%= "checked" if key == :normal %> data-action="lesson2-preview#size"> <%= label %></label>
      <% end %>
    </fieldset>
    <label><input type="checkbox" data-action="lesson2-preview#teacher" data-lesson2-preview-target="teacherToggle"> <%= t("lesson2.box.teacher_mode") %></label>
  </div>
  <p class="hint" role="status" data-lesson2-preview-target="status"></p>
  <div class="l2-box" data-theme="cream" data-size="normal" data-lesson2-preview-target="box">
    <div class="l2" data-lesson2-preview-target="root"></div>
  </div>
  <script type="application/json" data-lesson2-preview-target="body"><%= json_escape(body.to_json).html_safe %></script>
</div>

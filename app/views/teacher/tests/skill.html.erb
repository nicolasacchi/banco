<% content_for :title, t("teacher.skill.title", skill: @row.label_it) %>
<main class="page wide">
  <p><a href="<%= teacher_test_path(key: @subject.key) %>"><%= t("teacher.skill.back", subject: @subject.name_it) %></a></p>
  <h1><%= ref_for(@row.skill) %></h1>
  <p class="skill-nav">
    <a class="button secondary small" id="skill-all-link" href="<%= teacher_test_all_path(key: @subject.key) %>#skill-<%= @row.skill.tr('.', '-') %>"><%= t("teacher.test.all_link") %></a>
    <% if @previous %><a class="button secondary small" href="<%= skill_screen_path(@subject, @previous.skill) %>"><%= t("teacher.skill.previous") %></a><% end %>
    <% if @next %><a class="button secondary small" href="<%= skill_screen_path(@subject, @next.skill) %>"><%= t("teacher.skill.next") %></a><% end %>
  </p>
  <% if @row.not_assessed_reason_it %>
    <p class="notice"><%= t("teacher.skill.not_assessed") %> <%= @row.not_assessed_reason_it %></p>
  <% end %>
  <% if @row.redo_reserve == false %>
    <p class="notice" data-redo-reserve="false"><%= t("teacher.skill.no_redo_reserve") %></p>
  <% end %>
  <% if @row.choice_only_reason_it.present? %>
    <p class="notice" id="choice-only-reason"><%= t("teacher.skill.choice_only") %> <%= @row.choice_only_reason_it %></p>
  <% end %>
  <% blocker = decision_blocker %>
  <div class="cards">
    <% @cards.each do |card| %>
      <%= render "teacher/items/card", card: card, blocker: blocker %>
    <% end %>
  </div>
</main>

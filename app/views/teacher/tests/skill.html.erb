<% content_for :title, t("teacher.skill.title", skill: @row.label_it) %>
<main class="page wide skill-page">
  <header class="page-header">
    <h1><%= ref_for(@row.skill) %></h1>
    <div class="page-actions skill-nav">
      <% if @previous %><a class="button secondary small" href="<%= skill_screen_path(@subject, @previous.skill) %>"><%= ui_icon("prev") %> <%= t("teacher.skill.previous") %></a><% end %>
      <% if @next %><a class="button secondary small" href="<%= skill_screen_path(@subject, @next.skill) %>"><%= t("teacher.skill.next") %> <%= ui_icon("next") %></a><% end %>
      <a class="button secondary small" id="skill-all-link" href="<%= teacher_test_all_path(key: @subject.key) %>#skill-<%= @row.skill.tr('.', '-') %>"><%= t("teacher.test.all_link") %></a>
    </div>
  </header>
  <% if @row.not_assessed_reason_it %>
    <%= ui_notice :info, "#{t('teacher.skill.not_assessed')} #{@row.not_assessed_reason_it}" %>
  <% end %>
  <% if @row.redo_reserve == false %>
    <%= ui_notice :nearly, t("teacher.skill.no_redo_reserve"), html: { "data-redo-reserve": "false" } %>
  <% end %>
  <% if @row.choice_only_reason_it.present? %>
    <%= ui_notice :info, "#{t('teacher.skill.choice_only')} #{@row.choice_only_reason_it}", html: { id: "choice-only-reason" } %>
  <% end %>
  <% blocker = decision_blocker %>
  <div class="item-cards">
    <% @cards.each do |card| %>
      <%= render "teacher/items/card", card: card, blocker: blocker %>
    <% end %>
  </div>
</main>

<% content_for :title, t("teacher.report.title", subject: @subject.name_it) %>
<% row = @row %>
<% blocker = decision_blocker %>
<main class="page wide" data-report-status="<%= row[:status] %>">
  <%= ui_page_header t("teacher.report.title", subject: @subject.name_it) %>
  <%= render "teacher/student_picker" %>

  <section id="report-state" class="card">
    <h2 class="card-title"><%= t("teacher.report.state_title") %></h2>
    <ul class="plain facts">
      <li><strong><%= t("teacher.report.status.#{row[:status]}") %></strong></li>
      <li><%= t("teacher.report.graph_form.#{row[:graph_form]}") %></li>
      <li><%= t("teacher.report.entry_test", seq: row[:entry_test][:seq] || "-") %>
        <%= row[:entry_test][:approved] ? t("teacher.report.test_approved") : t("teacher.report.test_not_approved") %>
        <% if row[:entry_test][:pending_revision] %> <strong><%= t("teacher.report.pending_revision") %></strong><% end %></li>
      <% entry = row[:entry_test] %>
      <% if entry[:not_measured_it] %>
        <li id="report-not-measured"><%= t("teacher.test.settings.not_measured") %> <%= entry[:not_measured_it] %></li>
        <li id="report-test-settings"><%= t("teacher.test.settings.calculator") %> <%= t("teacher.test.settings.calculator_#{entry[:calculator]}", default: entry[:calculator].to_s) %> ·
          <%= t("teacher.test.settings.budget") %> <%= t("teacher.test.settings.budget_value", minutes: entry[:budget]&.dig("sitting_minutes"), sittings: entry[:budget]&.dig("sittings")) %> ·
          <%= t("teacher.test.settings.depends") %> <%= Array(entry[:depends_on_subjects]).presence&.join(", ") || t("teacher.test.settings.none") %>
          <% Array(entry[:kind_overrides]).each do |o| %><br><%= ref_for(o["skill"]) %> → <%= t("teacher.refs.kind.#{o["kind"]}", default: o["kind"]) %>: <%= o["reason_it"] %><% end %></li>
      <% end %>
      <li id="report-condition"><%= t("teacher.report.condition") %> <strong><%= t("teacher.report.unsupervised") %></strong></li>
      <% if row[:run] %>
        <li id="report-versions"><%= t("teacher.report.versions", rules: row[:run][:rules_version], engine: row[:run][:engine_version], graders: row[:run][:grader_versions].map { |g| "#{g[:grader]} #{g[:grader_version]}" }.join(", ").presence || "-") %></li>
        <li><%= t("teacher.report.minutes", count: row[:counted_minutes]) %>
          <% if row[:run][:end_reason] %> · <%= t("teacher.report.end_reason") %> <%= row[:run][:end_reason] %><% end %></li>
      <% end %>
    </ul>
  </section>

  <% if row[:run].nil? %>
    <%= ui_notice :info, t("teacher.report.no_run") %>
  <% else %>
    <section id="report-sittings">
      <h2><%= t("teacher.report.sittings") %></h2>
      <%= ui_table_wrap(label: t("teacher.report.sittings")) do %>
      <table class="data stack">
        <thead><tr><th>#</th><th><%= t("teacher.report.started") %></th><th><%= t("teacher.report.counted") %></th><th><%= t("teacher.report.served") %></th><th><%= t("teacher.report.closed_by") %></th></tr></thead>
        <tbody>
          <% row[:sittings].each do |s| %>
            <tr><td data-label="#"><%= s[:index] %></td><td data-label="<%= t("teacher.report.started") %>"><%= ui_time(s[:started_at]) %></td><td data-label="<%= t("teacher.report.counted") %>"><%= t("teacher.report.minutes_short", count: s[:counted_minutes]) %></td><td data-label="<%= t("teacher.report.served") %>"><%= s[:served] %></td><td data-label="<%= t("teacher.report.closed_by") %>"><%= s[:close_reason] || "-" %></td></tr>
          <% end %>
        </tbody>
      </table>
      <% end %>
    </section>

    <% if @map_ctx %><%= render "teacher/graphs/map", review: @map_ctx.review, ctx: @map_ctx, rows: @map_rows %><% end %>

    <section id="report-skills">
      <h2><%= t("teacher.report.skills") %></h2>
      <% fs = row[:formula_sheet] %>
      <p id="report-formula-sheet" data-available="<%= fs[:available] %>" data-opened="<%= fs[:opened] %>">
        <% if fs[:available].positive? %><strong><%= t("teacher.report.sheet.summary", available: fs[:available], total: fs[:attempts], opened: fs[:opened]) %></strong>
          <span class="hint"><%= t("teacher.report.sheet.hint") %></span>
        <% else %><%= t("teacher.report.sheet.none") %><% end %></p>
      <% %w[demonstrated to_recover to_learn pending not_assessed].each do |group| %>
        <% list = row[:skills].select { |s| s[:group] == group } %>
        <details class="disclosure report-group" <%= "open" if list.any? && %w[to_recover to_learn pending].include?(group) %>>
        <summary><h3 data-group="<%= group %>"><%= t("teacher.report.group.#{group}") %> (<%= list.size %>)</h3></summary>
        <% if list.any? %>
          <ul class="plain">
            <% list.each do |s| %>
              <li id="report-skill-<%= s[:skill].parameterize %>" data-skill="<%= s[:skill] %>"><strong><%= ref_for(s[:skill]) %></strong>
                <% if s[:reason] %> · <%= t("teacher.report.reason.#{s[:reason]}", default: s[:reason]) %><% end %>
                <% if s[:scope] %> · <%= scope_text(s[:scope]) %><% end %>
                <% sh = s[:formula_sheet] %>
                <% if s[:marks].present? %>
                  <br><strong data-marks="<%= s[:marks].size %>"><%= s[:marks].join(" · ") %></strong>
                  <span class="hint"><%= t("teacher.report.sheet.counts", available: sh[:available], opened: sh[:opened], total: sh[:attempts]) %></span>
                <% end %>
                <% lines = s[:lines][:prima] + s[:lines][:seconda] %>
                <% if lines.any? %><br><span class="hint"><%= lines.map { |l| "#{l[:source]} #{l[:line]}" }.join(", ") %></span><% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        </details>
      <% end %>
      <% unless row[:checks].empty? %>
        <%= ui_notice :nearly, t("teacher.report.checks", count: row[:checks].size) %>
      <% end %>
    </section>

    <section id="report-errors">
      <h2><%= t("teacher.report.errors") %></h2>
      <% if row[:errors_observed].empty? %>
        <p class="hint"><%= t("teacher.report.no_errors") %></p>
      <% else %>
        <%= ui_table_wrap(label: t("teacher.report.errors")) do %>
        <table class="data stack">
          <thead><tr><th><%= t("teacher.report.error_code") %></th><th><%= t("teacher.report.error_skill") %></th><th><%= t("teacher.report.error_count") %></th><th><%= t("teacher.report.error_examples") %></th></tr></thead>
          <tbody>
            <% row[:errors_observed].each do |e| %>
              <tr data-code="<%= e[:code] %>"><td data-label="<%= t("teacher.report.error_code") %>"><strong><%= e[:code] %></strong></td><td data-label="<%= t("teacher.report.error_skill") %>"><%= ref_for(e[:skill]) %></td><td data-label="<%= t("teacher.report.error_count") %>"><%= e[:count] %></td>
                <td data-label="<%= t("teacher.report.error_examples") %>"><% Array(e[:examples]).each do |text| %><q class="example"><%= text %></q> <% end %></td></tr>
            <% end %>
          </tbody>
        </table>
        <% end %>
      <% end %>
      <% if row[:unclassified].any? %><p><%= t("teacher.report.unclassified") %> <%= row[:unclassified].join(", ") %></p><% end %>
    </section>

    <% if row[:refused_tries].present? %>
      <section id="report-refused">
        <h2><%= t("teacher.refused_tries.title") %></h2>
        <ul class="plain">
          <% row[:refused_tries].each do |r| %>
            <li data-skill="<%= r[:skill] %>"><strong><%= ref_for(r[:skill]) %></strong>
              <% if r[:answer] %> · <%= t("teacher.practice.answer") %> <code><%= r[:answer] %></code><% end %>
              <%= render "teacher/refused_tries", tries: r[:tries].map { |x| Teacher::RefusedTries::Try.new(x[:text], x[:count]) } %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if row[:nearly_correct].present? %>
      <section id="report-nearly-correct">
        <h2><%= t("teacher.nearly_correct.title") %></h2>
        <ul class="plain">
          <% row[:nearly_correct].each do |r| %>
            <li data-skill="<%= r[:skill] %>"><strong><%= ref_for(r[:skill]) %></strong> · <%= t("teacher.nearly_correct.line") %> <%= r[:note_it] %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section id="report-signals">
      <h2><%= t("teacher.report.signals") %></h2>
      <% sig = row[:signals] %>
      <ul class="plain">
        <li data-signal="rapid_share"><%= t("teacher.report.rapid", percent: (sig[:rapid_share].to_f * 100).round) %>
          <% if sig[:flags].include?("rapid_share") %> <strong><%= t("teacher.report.flagged") %></strong><% end %></li>
        <li data-signal="dont_know_share"><%= t("teacher.report.dont_know", percent: (sig[:dont_know_share].to_f * 100).round, count: sig[:dont_know_count]) %>
          <% if sig[:flags].include?("dont_know_share") %> <strong><%= t("teacher.report.flagged") %></strong><% end %></li>
        <li><%= t("teacher.report.pending_answers", count: sig[:pending_answers]) %> <a href="<%= with_student("/teacher/corrections") %>"><%= t("teacher.nav.corrections") %></a></li>
      </ul>
      <p class="hint"><%= t("teacher.report.signals_hint") %></p>
    </section>

    <section id="report-controls">
      <details class="disclosure report-actions">
        <summary><%= t("teacher.report.controls") %></summary>
        <% run_id = row[:run][:id] %>
        <% { "void" => "void", "extend" => "extend", "close" => "close" }.each do |name, action| %>
          <details class="action-row" id="action-<%= name %>">
            <summary><%= t("teacher.report.control_button.#{name}") %></summary>
            <%= decision_form("/teacher/runs/#{run_id}/#{action}", id: "run-#{name}") do %>
              <label class="hint" for="reason-<%= name %>"><%= t("teacher.report.control.#{name}") %></label>
              <input id="reason-<%= name %>" class="answer-input wide" type="text" name="reason_it" placeholder="<%= t('teacher.report.reason_placeholder') %>" required>
              <div class="button-row"><button type="submit" class="button <%= name == "extend" ? "secondary" : "danger" %> small" <%= "disabled" if blocker %>><%= t("teacher.report.control_button.#{name}") %></button></div>
            <% end %>
          </details>
        <% end %>
        <% if @revisions.any? %>
          <details class="action-row" id="action-void-attempts">
            <summary><%= t("teacher.report.void_attempts_title") %></summary>
            <% @revisions.each do |revision| %>
              <details class="action-row nested">
                <summary><%= ref_for(revision, popover: false) %> · <%= t("teacher.skill.revision", seq: revision.seq) %></summary>
                <%= decision_form("/teacher/item-revisions/#{revision.id}/void-attempts", id: "void-attempts-#{revision.id}") do %>
                  <label class="hint" for="reason-void-<%= revision.id %>"><%= t("teacher.report.control_button.void_attempts") %></label>
                  <input id="reason-void-<%= revision.id %>" class="answer-input wide" type="text" name="reason_it" placeholder="<%= t('teacher.report.reason_placeholder') %>" required>
                  <div class="button-row"><button type="submit" class="button danger small" <%= "disabled" if blocker %>><%= t("teacher.report.control_button.void_attempts") %></button></div>
                <% end %>
              </details>
            <% end %>
          </details>
        <% end %>
      </details>
    </section>
  <% end %>
</main>

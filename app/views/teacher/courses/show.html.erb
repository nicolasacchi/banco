<% content_for :title, t("teacher.course.title", subject: @subject.name_it) %>
<main class="page wide">
  <p><a href="/teacher"><%= t("teacher.back") %></a></p>
  <h1><%= t("teacher.course.title", subject: @subject.name_it) %></h1>
  <% review = @review %>
  <% if !review.present? %>
    <p class="notice"><%= t("teacher.course.none") %></p>
  <% else %>
    <% counts = review.counts %>
    <p id="course-summary" data-open="<%= review.open? %>" data-ready="<%= review.ready_count %>">
      <%= t("teacher.path.summary.ready", count: review.ready_count) %> ·
      <%= t("teacher.path.summary.approved", count: counts[:approved]) %> ·
      <%= t("teacher.path.summary.missing", count: counts[:missing]) %> ·
      <strong><%= review.open? ? t("teacher.path.summary.open", to: student_dative(Student.official)) : t("teacher.path.summary.closed", to: student_dative(Student.official)) %></strong>
    </p>
    <p class="hint"><%= t("teacher.course.summary", seq: review.latest.seq, topics: t("teacher.course.topics_count", count: counts[:in_map]), approved: t("teacher.course.approved_count", count: counts[:approved])) %></p>
    <p><a class="button secondary small" id="course-practice-link" href="<%= with_student(teacher_practice_path(key: @subject.key)) %>"><%= t("teacher.course.practice_link") %></a>
      <span class="hint" id="course-practice-note"><%= t("teacher.course.practice_note") %></span></p>

    <% review.warnings.each do |w| %>
      <p class="notice" data-warning="<%= w["code"] %>"><strong><%= w["code"] %></strong> <%= t("teacher.course.warning.#{w["code"]}", default: w["message"]) %></p>
    <% end %>
    <% review.notes.each do |note| %><p class="hint" data-course-note><%= note %></p><% end %>

    <section id="course-topics">
      <h2><%= t("teacher.path.title") %></h2>
      <p class="hint"><%= t("teacher.path.intro") %></p>
      <p class="path-filter">
        <% if @only_ready %><a id="path-filter" data-active="true" href="<%= teacher_course_path(key: @subject.key) %>"><%= t("teacher.path.filter_off") %></a>
        <% else %><a id="path-filter" data-active="false" href="<%= teacher_course_path(key: @subject.key, only: "ready") %>"><%= t("teacher.path.filter_ready") %></a><% end %>
      </p>
      <% shown = review.steps.select { |st| !@only_ready || st.ready? } %>
      <% if shown.empty? %><p class="notice" id="path-empty"><%= t("teacher.path.none_ready") %></p><% end %>
      <ol class="path">
        <% shown.each do |step| %>
          <% entry = step.entry %>
          <li class="topic path-step" data-topic="<%= entry["key"] %>" data-stage="<%= step.row.stage %>" data-badge="<%= step.badge %>">
            <span class="step-number" aria-hidden="true"><%= step.number %></span>
            <div class="step-body">
              <h3>
                <% if step.lesson? %><a href="<%= teacher_topic_path(key: @subject.key, topic: entry["key"]) %>"><%= entry["title_it"] %></a><% else %><%= entry["title_it"] %><% end %>
                <span class="badge" data-stage-label data-badge-name="<%= step.badge %>"><%= t("teacher.path.badge.#{step.badge}") %></span>
              </h3>
              <p class="hint step-kind"><%= t("teacher.path.kind.#{entry['kind']}") %> · <%= t("teacher.course.minutes", count: entry["minutes"]) %>
                <% if entry["term"] %> · <%= t("teacher.course.term", n: entry["term"]) %><% end %></p>
              <p class="step-skills"><%= t("teacher.path.skills") %> <%= safe_join(entry["skills"].map { |k| ref_for(k) }, ", ") %></p>
              <% if step.missing_it %><p class="step-missing" data-missing><%= step.missing_it %></p><% end %>
              <% if step.lesson? %>
                <ul class="plain step-counts" data-counts>
                  <li data-count="lesson"><%= t("teacher.path.lesson_yes") %></li>
                  <li data-count="exercises"><%= t("teacher.path.exercises", count: step.exercises) %></li>
                  <li data-count="findings" data-open="<%= step.open_findings %>"><%= t("teacher.path.findings", count: step.open_findings) %></li>
                </ul>
              <% else %>
                <p class="hint" data-count="lesson"><%= t("teacher.path.lesson_no") %></p>
              <% end %>
              <% step.progress.each do |pr| %>
                <p class="hint step-progress" data-progress="<%= pr.student.key %>"><%= t("teacher.path.progress", who: student_label(pr.student), tries: t("teacher.path.tries", count: pr.tries), skills: t("teacher.path.skills_shown", count: pr.done, total: pr.total)) %></p>
              <% end %>
              <% if step.ready? %>
                <p><a class="button" data-review-button href="<%= teacher_topic_path(key: @subject.key, topic: entry["key"]) %>"><%= t("teacher.path.review") %></a></p>
              <% elsif step.lesson? %>
                <p><a class="button secondary small" data-look-button href="<%= teacher_topic_path(key: @subject.key, topic: entry["key"]) %>"><%= t("teacher.path.look") %></a>
                  <span class="hint" data-look-hint><%= t("teacher.path.look_hint.#{step.badge}") %></span></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </section>

    <section id="course-release" data-open="<%= review.open? %>" data-releasable="<%= review.releasable? %>">
      <h2><%= t("teacher.path.release.title") %></h2>
      <p><%= t("teacher.path.release.needs") %></p>
      <ul class="plain checks" data-release-checks>
        <% review.release_checks.each do |name, done| %>
          <li data-check="<%= name %>" data-done="<%= done %>"><span class="tick" aria-hidden="true"><%= done ? "\u2713" : "\u25CB" %></span> <%= t("teacher.path.release.check.#{name}") %> <strong><%= done ? t("teacher.path.done") : t("teacher.path.todo") %></strong></li>
        <% end %>
      </ul>
      <p class="hint" id="trial-note"><%= t("teacher.path.release.trial") %></p>
      <% blocker = decision_blocker %>
      <% if review.open? %>
        <p><%= review.released_latest? ? t("teacher.course.release.is_open") : t("teacher.course.release.open_older") %></p>
        <%= decision_form("/teacher/subjects/#{@subject.key}/course-release", id: "course-close-form") do %>
          <%= hidden_field_tag :open, "0", id: "course-close-open" %>
          <button type="submit" class="button secondary" <%= "disabled" if blocker %>><%= t("teacher.course.release.close") %></button>
        <% end %>
      <% end %>
      <% unless review.released_latest? %>
        <%= decision_form("/teacher/subjects/#{@subject.key}/course-release", id: "course-open-form") do %>
          <%= hidden_field_tag :open, "1", id: "course-open-open" %>
          <button type="submit" class="button" <%= "disabled" if blocker || !review.releasable? %> aria-describedby="course-release-why"><%= review.open? ? t("teacher.course.release.reopen") : t("teacher.course.release.open") %></button>
        <% end %>
        <div id="course-release-why" class="hint">
          <% if review.releasable? %>
            <p><%= t("teacher.course.release.hint") %></p>
          <% else %>
            <p><%= t("teacher.course.release.cannot_yet") %></p>
            <ul class="plain reasons"><% review.release_reasons.each do |reason| %><li><%= Teacher::Wording.italian(reason) %></li><% end %></ul>
          <% end %>
        </div>
      <% end %>
    </section>


    <% if review.skills.any? %>
      <section id="course-skills">
        <h2><%= t("teacher.course.skills") %></h2>
        <p class="hint"><%= t("teacher.course.skills_intro") %></p>
        <% review.skills.each do |skill| %>
          <article class="card" data-skill="<%= skill.key %>">
            <h3><%= skill.label_it %> <span class="key">(<%= skill.key %>)</span></h3>
            <ul class="plain refs">
              <% skill.refs.each do |r| %>
                <li><%= t("teacher.course.ref", line: r.line, role: t("teacher.course.role.#{r.role}")) %>
                  <q><%= r.fragment %></q><% if r.text %><br><span class="hint"><%= t("teacher.course.programme_line") %></span> <%= r.text %><% end %></li>
              <% end %>
            </ul>
            <% if skill.errors.any? %>
              <p><strong><%= t("teacher.course.errors") %></strong></p>
              <ul class="plain"><% skill.errors.each do |e| %><li><strong><%= e["code"] %></strong>: <%= e["description_it"] %></li><% end %></ul>
            <% end %>
          </article>
        <% end %>
      </section>
    <% end %>
  <% end %>
</main>

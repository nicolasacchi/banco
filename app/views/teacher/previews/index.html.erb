<% content_for :title, t("teacher.preview.test_title") %>
<main class="page">
  <h1><%= t("teacher.preview.test_title") %></h1>
  <p><%= t("teacher.preview.intro") %></p>
  <ul class="subjects">
    <% @subjects.each do |subject| %>
      <li class="subject" data-subject="<%= subject.key %>">
        <span class="subject-name"><%= subject.name_it %></span>
        <%= button_to t("teacher.preview.start", subject: subject.name_it), "/teacher/preview/subjects/#{subject.key}", class: "button", form: { class: "inline" } %>
      </li>
    <% end %>
  </ul>
  <p><a class="button secondary" href="/teacher/preview"><%= t("teacher.preview.back_to_today") %></a></p>
</main>

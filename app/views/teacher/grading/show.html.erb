<% content_for :title, t("teacher.grading.title") %>
<main class="page wide" id="grading-page">
  <%= ui_page_header t("teacher.grading.title"), back: [ t("teacher.menu.home"), with_student("/teacher") ], sub: t("teacher.grading.intro") %>
  <%= render "teacher/student_picker", keep: @filters %>

  <form class="ratings-filters" id="grading-filters" method="get" action="<%= teacher_grading_path %>" aria-label="<%= t("teacher.grading.filters.label") %>">
    <% student_param.each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
    <label for="grading-subject"><%= t("teacher.grading.filters.subject") %>
      <select id="grading-subject" name="subject" class="answer-input">
        <option value=""><%= t("teacher.grading.filters.all") %></option>
        <% @subjects.each do |subject| %><option value="<%= subject.key %>"<%= " selected" if @filters[:subject] == subject.key %>><%= subject.name_it %></option><% end %>
      </select>
    </label>
    <label for="grading-since"><%= t("teacher.grading.filters.since") %>
      <input id="grading-since" name="since" type="date" class="answer-input" value="<%= @filters[:since] %>">
    </label>
    <button type="submit" class="button" id="grading-filter-button"><%= t("teacher.grading.filters.apply") %></button>
    <% if @filters.any? %><a class="button secondary" id="grading-filters-clear" href="<%= teacher_grading_path(student_param) %>"><%= t("teacher.grading.filters.clear") %></a><% end %>
  </form>

  <% if @review.nil? %>
    <div id="grading-none"><%= ui_empty t("teacher.grading.none") %></div>
  <% elsif @review.items.empty? && @review.lesson_contests.empty? %>
    <div id="grading-empty"><%= ui_empty t(@filters.any? ? "teacher.grading.empty" : "teacher.grading.empty_unfiltered") %></div>
  <% else %>
    <% totals = @review.totals %>
    <h2 id="grading-totals-title"><%= t("teacher.grading.totals.title") %></h2>
    <ul class="plain" id="grading-totals">
      <li data-total="tries"><%= t("teacher.grading.totals.tries", n: totals[:tries]) %></li>
      <li data-total="not_right"><%= t("teacher.grading.totals.not_right", n: totals[:not_right]) %></li>
      <li data-total="written"><%= t("teacher.grading.totals.written", n: totals[:written_not_right], total: totals[:written_tries]) %></li>
      <li data-total="manual"><%= t("teacher.grading.totals.manual", n: totals[:manual_corrections]) %></li>
      <li data-total="resends"><%= t("teacher.grading.totals.resends", n: totals[:resends]) %></li>
      <li data-total="contested"><%= t("teacher.grading.totals.contested", n: totals[:contested]) %></li>
      <li data-total="lesson_contested"><%= t("teacher.grading.totals.lesson_contested", n: totals[:lesson_contested]) %></li>
      <li data-total="flagged"><%= t("teacher.grading.totals.flagged", n: totals[:flagged_items]) %></li>
      <% if totals[:superseded].positive? %><li data-total="superseded" class="hint"><%= t("teacher.grading.totals.superseded", n: totals[:superseded]) %></li><% end %>
    </ul>

    <% flagged, others = @review.items.partition { |item| item[:flagged] } %>
    <h2 id="grading-items-title"><%= t("teacher.grading.items_title") %></h2>
    <p class="hint"><%= t("teacher.grading.items_hint") %></p>
    <% if flagged.any? %>
      <%= render "teacher/grading/items", id: "grading-items", rows: flagged, label: t("teacher.grading.items_title") %>
    <% else %>
      <p class="hint" id="grading-flagged-none"><%= t("teacher.grading.flagged_none") %></p>
    <% end %>
    <% if others.any? %>
      <details class="disclosure" id="grading-items-others"<%= " open" if flagged.empty? %>>
        <summary><%= t("teacher.grading.others", count: others.size) %></summary>
        <%= render "teacher/grading/items", id: "grading-items-rest", rows: others, label: t("teacher.grading.others", count: others.size) %>
      </details>
    <% end %>

    <h2 id="grading-tries-title"><%= t("teacher.grading.tries_title") %></h2>
    <% suspect = @review.suspect_tries %>
    <% if suspect.empty? %>
      <%= ui_empty t("teacher.grading.tries_none") %>
    <% else %>
      <p class="hint"><%= t("teacher.grading.tries_hint") %></p>
      <% words = reader_only? ? {} : @review.answer_words %>
      <% by_item = suspect.group_by { |try| try[:item] } %>
      <div id="grading-tries">
        <%# one fold per exercise, the flagged ones first (the order of the list above) and open; the others closed: on a phone the page stays short %>
        <% @review.items.select { |item| by_item.key?(item[:item]) }.each do |item| %>
          <% tries = by_item.fetch(item[:item]) %>
          <details class="disclosure grading-group" id="grading-group-<%= item[:item] %>" data-item="<%= item[:item] %>" data-flagged="<%= item[:flagged] %>"<%= " open" if item[:flagged] %>>
            <summary>
              <span class="grading-group-title"><%= ref_for(item[:item], popover: false) %> <span class="hint"><%= @subject_names.fetch(item[:subject], item[:subject]) %></span></span>
              <span class="grading-group-count"><%= t("teacher.grading.group_count", count: tries.size) %></span>
              <% if item[:flagged] %><%= ui_pill(t("teacher.grading.flagged"), :nearly, icon: "alert") %><% end %>
            </summary>
            <%= ui_table_wrap(label: t("teacher.grading.tries_title")) do %>
              <table class="data stack">
                <thead><tr><th><%= t("teacher.grading.col.when") %></th><th><%= t("teacher.grading.col.kind") %></th><th><%= t("teacher.grading.col.outcome") %></th><th><%= t("teacher.grading.col.answer") %></th><th><%= t("teacher.grading.col.signals") %></th></tr></thead>
                <tbody>
                  <% tries.each do |try| %>
                    <tr id="grading-try-<%= try[:ref] %>" data-ref="<%= try[:ref] %>" data-signals="<%= try[:signals].join(" ") %>">
                      <td data-label="<%= t("teacher.grading.col.when") %>"><%= ui_time(try[:at]) %></td>
                      <td data-label="<%= t("teacher.grading.col.kind") %>"><%= t("teacher.grading.kind.#{try[:kind]}") %></td>
                      <td data-label="<%= t("teacher.grading.col.outcome") %>">
                        <span data-outcome="<%= try[:outcome] %>"><%= t("teacher.grading.outcome.#{try[:outcome]}") %></span>
                        <% if try[:resolution] %><br><span class="hint"><%= t("teacher.grading.resolution", verdict: t("teacher.grading.outcome.#{try[:resolution][:verdict]}")) %></span><% end %>
                      </td>
                      <td data-label="<%= t("teacher.grading.col.answer") %>">
                        <% if reader_only? %><span class="hint" data-hidden-text><%= t("teacher.grading.hidden") %></span>
                        <% else %><q class="student-text grading-answer" data-student-text><%= words.fetch(try[:ref]).to_s.truncate(600) %></q><% end %>
                      </td>
                      <td data-label="<%= t("teacher.grading.col.signals") %>">
                        <ul class="plain">
                          <% try[:signals].each do |signal| %>
                            <li data-signal="<%= signal %>"><%= signal == "near_text" ? t("teacher.grading.signal.near_text", count: try[:near_distance]) : t("teacher.grading.signal.#{signal}") %></li>
                          <% end %>
                        </ul>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          </details>
        <% end %>
      </div>
    <% end %>

    <%# the checks of the lessons that he sent with «Per me va bene così»: no comment is written for them (D-400), so this is where the teacher reads them %>
    <% contests = @review.lesson_contests %>
    <h2 id="grading-lesson-contests-title"><%= t("teacher.grading.lesson_contests.title") %></h2>
    <% if contests.empty? %>
      <%= ui_empty t("teacher.grading.lesson_contests.none") %>
    <% else %>
      <p class="hint"><%= t("teacher.grading.lesson_contests.hint") %></p>
      <%= ui_table_wrap(label: t("teacher.grading.lesson_contests.title")) do %>
        <table class="data stack" id="grading-lesson-contests">
          <thead><tr><th><%= t("teacher.grading.col.when") %></th><th><%= t("teacher.grading.col.subject") %></th><th><%= t("teacher.grading.lesson_contests.lesson") %></th><th><%= t("teacher.grading.lesson_contests.place") %></th><th><%= t("teacher.grading.col.answer") %></th></tr></thead>
          <tbody>
            <% contests.each do |contest| %>
              <tr id="grading-lesson-contest-<%= contest[:id] %>" data-ref="<%= contest[:ref] %>">
                <td data-label="<%= t("teacher.grading.col.when") %>"><%= ui_time(contest[:at]) %></td>
                <td data-label="<%= t("teacher.grading.col.subject") %>"><%= @subject_names.fetch(contest[:subject], contest[:subject]) %></td>
                <td data-label="<%= t("teacher.grading.lesson_contests.lesson") %>"><%= contest[:topic] %></td>
                <td data-label="<%= t("teacher.grading.lesson_contests.place") %>"><%= lesson_contest_place(contest) %></td>
                <td data-label="<%= t("teacher.grading.col.answer") %>">
                  <% if reader_only? %><span class="hint" data-hidden-text><%= t("teacher.grading.hidden") %></span>
                  <% elsif contest[:answer] %><q class="student-text grading-answer" data-student-text><%= contest[:answer].to_s.truncate(600) %></q>
                  <% elsif contest[:comment_ids].any? %><span class="hint"><%= t("teacher.grading.lesson_contests.in_comment", ids: contest[:comment_ids].join(", ")) %></span>
                  <% else %><span class="hint"><%= t("teacher.grading.lesson_contests.no_words") %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>
  <% end %>
</main>

<% content_for :title, t("teacher.dashboard.title") %>
<main class="page wide dashboard" id="dashboard"
      data-controller="dashboard"
      data-dashboard-state-url-value="<%= teacher_dashboard_state_path(student_param) %>"
      data-dashboard-fragment-url-value="<%= teacher_dashboard_fragment_path(student_param) %>"
      data-dashboard-digest-value="<%= @digest %>"
      data-dashboard-interval-value="<%= Teacher::Dashboard.poll_seconds %>"
      data-dashboard-slow-after-value="<%= Teacher::Dashboard.slow_after %>"
      data-dashboard-stamp-text-value="<%= t('teacher.dashboard.stamp', time: '{time}') %>"
      data-dashboard-updated-text-value="<%= t('teacher.dashboard.updated_now') %>"
      data-dashboard-announce-text-value="<%= t('teacher.dashboard.announce', names: '{names}') %>"
      data-dashboard-announce-other-text-value="<%= t('teacher.dashboard.announce_other') %>"
      data-dashboard-failed-text-value="<%= t('teacher.dashboard.failed') %>">
  <h1><%= t("teacher.dashboard.title") %></h1>
  <%= render "teacher/student_picker" %>

  <div class="dash-tools">
    <span class="hint" data-dashboard-target="stamp" id="dashboard-stamp"></span>
    <button type="button" class="button secondary small" data-action="dashboard#refresh" id="dashboard-refresh"><%= t("teacher.dashboard.refresh") %></button>
    <label class="dash-toggle"><input type="checkbox" checked data-dashboard-target="newtab" data-action="dashboard#toggleNewTab" id="dashboard-newtab"> <%= t("teacher.dashboard.new_tabs") %></label>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-dashboard-target="live" id="dashboard-live"></p>

  <div id="dashboard-body" data-dashboard-target="body">
    <%= render "teacher/dashboard/body", dashboard: @dashboard %>
  </div>
  <% unless reader_only? %><p><a class="button" href="/teacher/preview" data-newtab><%= t("teacher.preview.title") %></a></p><% end %>
</main>

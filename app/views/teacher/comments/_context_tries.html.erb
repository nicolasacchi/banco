<%# D-380: the tries listed on a comment's card, oldest first; his words are the teacher's (D-346), read as he read them (Teacher::AnswerWords), never the stored data. %>
<ol class="comment-context-tries">
  <% rows.each do |row| %>
    <li data-try="<%= row[:ref] %>">
      <%= t("teacher.comments.context.try_row", at: Time.zone.parse(row[:at]).strftime("%d/%m/%Y %H:%M"), kind: t("teacher.comments.context.kind.#{row[:kind]}"),
            outcome: t("teacher.grading.outcome.#{row[:outcome]}", default: row[:outcome].to_s)) %><% if row[:try_number] %> · <%= t("teacher.comments.context.try_number", n: row[:try_number]) %><% end %>
      <% if row[:answer].present? %>
        <% text = words[row[:ref]] %>
        <br><%= text ? t("teacher.comments.context.answer", text: text.truncate(400).gsub("\n", " · ")) : t("teacher.comments.context.answer_unreadable") %>
      <% end %>
      <% if row[:anchor_row].present? %><br><%= t("teacher.comments.context.anchor_row", text: comment_anchor_row_words(row[:anchor_row]).truncate(300)) %><% end %>
    </li>
  <% end %>
</ol>

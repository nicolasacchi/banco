<% content_for :title, t("teacher.play.title") %>
<main class="page" data-controller="item-play"
      data-item-play-url-value="<%= teacher_item_play_data_path(revision_id: @revision.id) %>?n=<%= @n %>"
      data-item-play-texts-value="<%= student_texts.to_json %>"
      data-item-play-sent-text-value="<%= t('teacher.play.sent') %>">
  <p class="banner"><%= t("teacher.play.banner") %></p>
  <h1><%= ref_for(@revision) %> <span class="key"><%= t("teacher.skill.revision", seq: @revision.seq) %></span></h1>
  <p><%= t("teacher.play.instance", n: @n, count: @count) %>
    <% if @n > 1 %><a href="<%= teacher_item_play_path(revision_id: @revision.id, n: @n - 1) %>"><%= t("teacher.skill.previous") %></a><% end %>
    <% if @n < @count %><a href="<%= teacher_item_play_path(revision_id: @revision.id, n: @n + 1) %>"><%= t("teacher.skill.next") %></a><% end %>
  </p>
  <div data-item-play-target="box" class="item"></div>
  <div class="actions">
    <button type="button" class="button" data-action="item-play#send" data-item-play-target="send"><%= t("sitting.send") %></button>
  </div>
  <p role="status" aria-live="polite" class="status" data-item-play-target="status"></p>
  <p><a class="button secondary" href="<%= @back_path %>"><%= t("teacher.play.back") %></a></p>
</main>

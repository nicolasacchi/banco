<% home = dashboard.home %>
<% counts = dashboard.counts %>
<ul class="stat-strip" id="waiting-counts" aria-label="<%= t('teacher.dashboard.counts_label') %>">
  <% %i[findings corrections topics comments].each do |kind| %>
    <li class="stat<%= ' zero' if counts.public_send(kind).zero? %>" data-count="<%= kind %>"><b><%= counts.public_send(kind) %></b> <span><%= t("teacher.dashboard.count.#{kind}") %></span></li>
  <% end %>
</ul>

<section aria-labelledby="todo-title" id="todo" class="card<%= ' action' if dashboard.todos.any? %>">
  <h2 id="todo-title" class="card-title"><%= t("teacher.dashboard.todo_title") %></h2>
  <% if dashboard.todos.empty? %>
    <p id="todo-empty" data-row-key="todo-empty"><%= ui_icon("circle-check") %> <%= t("teacher.dashboard.todo_empty") %></p>
  <% else %>
    <ol class="todo-list" id="todo-list">
      <% dashboard.todos.each do |todo| %>
        <li data-todo="<%= todo.kind %>" data-row-key="todo-<%= todo.kind %>-<%= todo.subject&.key %>" data-row-name="<%= todo.subject&.name_it %>">
          <%= render "teacher/dashboard/todo", todo: todo %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>

<h2><%= t("teacher.home.subjects") %></h2>
<ul class="cards dash-subjects teacher-subjects">
  <% home.rows.each do |row| %>
    <% key = row.subject.key %>
    <% w = row.waiting.to_h %>
    <% stage_tone = { "awaiting_teacher" => :nearly, "approved" => :success }.fetch(row.stage, :info) %>
    <% test_pill = if !row.has_blueprint then [ t("teacher.dashboard.not_written").delete_suffix("."), :muted ]
                   elsif w.key?(:test_to_approve) then [ t("teacher.dashboard.to_approve"), :nearly ]
                   elsif row.blocked then [ t("teacher.dashboard.to_fix"), :error ]
                   elsif row.stage == "approved" then [ t("teacher.dashboard.approved"), :success ]
                   else [ t("teacher.dashboard.in_progress"), :info ] end %>
    <% next_action = if w.key?(:graph_to_approve) then [ :graph, teacher_graph_path(key: key) ]
                     elsif w[:findings].to_i.positive? && row.has_blueprint then [ :findings, "#{teacher_test_path(key: key)}#open-findings" ]
                     elsif w.key?(:test_to_approve) then [ :test_ready, teacher_test_path(key: key) ]
                     elsif row.blocked then [ :test_blocked, teacher_test_path(key: key) ]
                     elsif row.course&.awaiting.to_i.positive? then [ :topics, teacher_course_path(key: key, only: "ready") ]
                     end %>
    <li class="subject card dash-row" data-subject="<%= key %>" data-stage="<%= row.stage %>" data-row-key="subject-<%= key %>" data-row-name="<%= row.subject.name_it %>">
      <div class="subject-head cluster">
        <h3 class="subject-name card-title"><%= row.subject.name_it %></h3>
        <span class="subject-state pill <%= stage_tone %>"><strong><%= stage_label(row.stage) %></strong></span>
      </div>
      <div class="dash-cells">
        <div class="dash-cell" data-cell="graph">
          <div class="cell-head"><%= ui_icon("map") %><h4><% if row.has_graph %><%= dash_link t("teacher.dashboard.graph"), teacher_graph_path(key: key) %><% else %><%= t("teacher.dashboard.graph") %><% end %></h4>
            <% if !row.has_graph %><%= ui_pill(t("teacher.dashboard.not_written").delete_suffix("."), :muted) %>
            <% elsif w.key?(:graph_to_approve) %><%= ui_pill(t("teacher.dashboard.to_approve"), :nearly) %>
            <% else %><%= ui_pill(t("teacher.dashboard.approved"), :success, icon: "circle-check") %><% end %></div>
        </div>
        <div class="dash-cell" data-cell="test">
          <div class="cell-head"><%= ui_icon("list-checks") %><h4><% if row.has_blueprint %><%= dash_link t("teacher.dashboard.test"), teacher_test_path(key: key) %><% else %><%= t("teacher.dashboard.test") %><% end %></h4>
            <%= ui_pill(test_pill[0], test_pill[1], icon: (test_pill[1] == :success ? "circle-check" : nil)) %></div>
          <% if row.waiting.any? %>
            <ul class="plain waiting" aria-label="<%= t('teacher.home.waiting') %>">
              <% row.waiting.each do |code, count| %>
                <li data-waiting="<%= code %>"><strong><% if code == :graph_to_approve %><%= dash_link t("teacher.home.wait.#{code}", count: 0), teacher_graph_path(key: key) %><% elsif code == :findings && row.has_blueprint %><%= dash_link t("teacher.home.wait.#{code}", count: count.to_i), "#{teacher_test_path(key: key)}#open-findings" %><% else %><%= t("teacher.home.wait.#{code}", count: count.to_i) %><% end %></strong><% if code == :findings && row.clear.positive? %> <%= dash_link t("teacher.dashboard.clear_of", count: row.clear), "#{teacher_test_path(key: key)}#follow-opinions-form" %><% end %></li>
              <% end %>
            </ul>
          <% end %>
          <% if row.blocked %><p class="hint" data-blocked><%= row.blocked %></p><% end %>
        </div>
        <div class="dash-cell" data-cell="course">
          <div class="cell-head"><%= ui_icon("book-open") %><h4><%= t("teacher.dashboard.course") %></h4>
            <% if row.course %><%= row.course.open ? ui_pill(t("teacher.dashboard.course_open"), :success, icon: "circle-check") : ui_pill(t("teacher.dashboard.course_closed"), :muted) %>
            <% else %><%= ui_pill(t("teacher.dashboard.not_written").delete_suffix("."), :muted) %><% end %></div>
          <% if row.course %>
            <% done = row.course.total.zero? ? 0 : (100 * row.course.approved / row.course.total) %>
            <%= ui_meter(done, t("teacher.home.course_line", approved: row.course.approved, total: row.course.total)) %>
            <p class="course-line" data-course-line><%= dash_link "#{t('teacher.home.course_line', approved: row.course.approved, total: row.course.total)} · #{row.course.open ? t('teacher.home.course_open') : t('teacher.home.course_closed')}", teacher_course_path(key: key) %></p>
            <p class="hint"><%= t("teacher.dashboard.topics_line", awaiting: row.course.awaiting, approved: row.course.approved, missing: row.course.missing) %>
              <% if row.course.awaiting.positive? %><%= dash_link t("teacher.dashboard.review_and_approve"), teacher_course_path(key: key, only: "ready") %><% end %>
              <% if row.course.in_review.positive? %><%= t("teacher.dashboard.lessons_in_review", count: row.course.in_review) %><% end %></p>
          <% else %>
            <p class="hint"><%= t("teacher.dashboard.no_course") %></p>
          <% end %>
        </div>
        <div class="dash-cell" data-cell="students">
          <div class="cell-head"><%= ui_icon("pin") %><h4><%= t("teacher.dashboard.students") %></h4></div>
          <ul class="plain dash-students">
            <% dashboard.students.each do |student| %>
              <% cell = dashboard.cell(student, row.subject) %>
              <li data-student-cell="<%= student.key %>">
                <%= dash_link student_label(student), with_student_for(student, teacher_report_path(key: key)) %>:
                <% if student.official? %><%= cell.diagnosis ? "#{cell.diagnosis}." : t("teacher.dashboard.no_diagnosis") %><% end %>
                <%= cell.last_at ? t("teacher.dashboard.last_activity", at: teacher_time(cell.last_at)) : t("teacher.dashboard.no_activity") %>
                <% if cell.practised.positive? %><%= t("teacher.dashboard.practised", count: cell.practised) %><% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <div class="button-row card-foot">
        <% if next_action %><%= dash_link t("teacher.dashboard.next.#{next_action[0]}"), next_action[1], class: "button" %><% end %>
        <%= dash_link t("teacher.home.open_report"), with_student(teacher_report_path(key: key)), class: "button #{next_action ? 'secondary' : ''}".strip %>
      </div>
    </li>
  <% end %>
</ul>

<section aria-labelledby="state-title" id="state">
  <h2 id="state-title"><%= t("teacher.dashboard.state_title") %></h2>
  <ul class="plain state-list" id="waiting-summary">
    <li><%= t("teacher.home.subjects_waiting", count: home.waiting_total) %></li>
    <li><%= dash_link t("teacher.home.corrections", count: home.corrections), with_student("/teacher/corrections") %></li>
    <li><%= t("teacher.home.minutes_total", count: home.minutes[:total]) %></li>
    <li id="release-state"><%= home.released? ? t("teacher.home.released") : t("teacher.home.not_released") %>
      <%= t("teacher.home.consent_#{home.consent_recorded? ? 'yes' : 'no'}") %>
      <%= t("teacher.dashboard.warmup_#{dashboard.release.warmup ? 'yes' : 'no'}") %>
      <%= t("teacher.dashboard.approvals", done: dashboard.release.approved, total: dashboard.release.total) %></li>
  </ul>
</section>

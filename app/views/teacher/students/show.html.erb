<% content_for :title, t("teacher.students.title") %>
<main class="page wide" id="students-page">
  <%= ui_page_header t("teacher.students.title") %>
  <% if @students.empty? %>
    <%= ui_empty t("teacher.students.none") %>
  <% end %>
  <% @students.each do |student| %>
    <section class="card" aria-labelledby="student-<%= student.key %>" data-student="<%= student.key %>">
      <h2 id="student-<%= student.key %>" class="card-title"><%= student_label(student) %></h2>
      <ul class="student-subjects">
        <% @subjects.each do |subject| %>
          <li><strong><%= subject.name_it %></strong>
            <span class="button-row"><a class="button secondary small" href="<%= with_student_for(student, teacher_report_path(key: subject.key)) %>"><%= t("teacher.menu.report") %></a>
            <a class="button secondary small" href="<%= with_student_for(student, teacher_practice_path(key: subject.key)) %>"><%= t("teacher.menu.practice") %></a></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</main>

<% if student_choices.any? %>
  <nav class="student-picker" id="student-picker" aria-label="<%= t('teacher.student_picker.label') %>">
    <%= t("teacher.student_picker.label") %>:
    <% student_choices.each do |student| %>
      <% query = student.official? ? "" : "?#{{ student: student.key }.to_query}" %>
      <% if student == viewed_student %><strong data-student="<%= student.key %>"><%= student_label(student) %></strong>
      <% else %><a data-student="<%= student.key %>" href="<%= request.path %><%= query %>"><%= student_label(student) %></a><% end %>
    <% end %>
  </nav>
<% end %>

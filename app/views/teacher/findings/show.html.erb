<% content_for :title, t("teacher.findings.title") %>
<main class="page wide" id="findings-page">
  <%= ui_page_header t("teacher.findings.title") %>
  <% if @todos.empty? %>
    <div id="findings-empty"><%= ui_empty t("teacher.findings.empty"), icon: "circle-check" %></div>
  <% else %>
    <ul class="todo-list" id="findings-list">
      <% @todos.each do |todo| %>
        <li data-todo="findings"><%= render "teacher/dashboard/todo", todo: todo %></li>
      <% end %>
    </ul>
  <% end %>
</main>

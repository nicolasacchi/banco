<%# «Novità» (D-375): the entries git holds, the topics revised, and his own comments on a topic that was revised after them. Newest first. %>
<% content_for :title, t("changelog.title") %>
<% locale = I18n.locale %>
<% fresh = ->(at) { @since && at > @since } %>
<main class="page course changelog-page" id="changelog-page" data-comment-anchor="page">
  <h1><%= t("changelog.title") %></h1>
  <p class="changelog-intro" id="changelog-intro"><%= t("changelog.intro") %></p>
  <% if preview? %><%= ui_notice :info, t("changelog.preview_note"), html: { id: "changelog-preview-note" } %><% end %>
  <% if @feed.empty? %><p id="changelog-empty"><%= t("changelog.empty") %></p><% end %>

  <% if @feed.followups.any? %>
    <section class="changelog-section" id="changelog-followups" aria-labelledby="changelog-followups-title">
      <h2 id="changelog-followups-title"><%= t("changelog.followups.title") %></h2>
      <ul class="changelog-list">
        <% @feed.followups.each do |followup| %>
          <li class="changelog-item changelog-followup" data-comment="<%= followup.comment_id %>" data-new="<%= fresh.(followup.revised_at) ? "true" : "false" %>">
            <p><%= t("changelog.followups.line", place: followup.place_it, date: I18n.l(followup.date, format: "%-d %B %Y")) %>
              <% if fresh.(followup.revised_at) %><%= ui_pill(t("changelog.new"), :nearly) %><% end %></p>
            <a class="button secondary small" href="/comments/<%= followup.comment_id %>"><%= t("changelog.followups.open") %></a>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @feed.entries.any? %>
    <section class="changelog-section" id="changelog-entries" aria-labelledby="changelog-entries-title">
      <h2 id="changelog-entries-title"><%= t("changelog.entries.title") %></h2>
      <ul class="changelog-list">
        <% @feed.entries.each do |entry| %>
          <li class="changelog-item" data-entry="<%= entry.id %>" data-kind="<%= entry.kind %>" data-new="<%= fresh.(entry.at) ? "true" : "false" %>">
            <p class="changelog-meta">
              <time datetime="<%= entry.date.iso8601 %>"><%= I18n.l(entry.date, format: "%-d %B %Y") %></time>
              <%= ui_pill(t("changelog.kinds.#{entry.kind}"), :muted) %>
              <% if fresh.(entry.at) %><%= ui_pill(t("changelog.new"), :nearly) %><% end %>
            </p>
            <h3><%= entry.title(locale) %></h3>
            <p><%= entry.body(locale) %></p>
            <% if entry.link %><a class="button secondary small" href="<%= spath(entry.link) %>"><%= t("changelog.entries.open") %></a><% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @feed.days.any? %>
    <section class="changelog-section" id="changelog-updates" aria-labelledby="changelog-updates-title">
      <h2 id="changelog-updates-title"><%= t("changelog.updates.title") %></h2>
      <% @feed.days.each do |date, list| %>
        <h3 class="changelog-day" data-day="<%= date.iso8601 %>"><%= I18n.l(date, format: "%-d %B %Y") %></h3>
        <ul class="changelog-list">
          <% list.each do |update| %>
            <li class="changelog-item" data-topic="<%= update.topic %>" data-new="<%= fresh.(update.at) ? "true" : "false" %>">
              <h4><%= t("changelog.updates.line", topic: update.title_it) %> <% if fresh.(update.at) %><%= ui_pill(t("changelog.new"), :nearly) %><% end %></h4>
              <p><%= t("changelog.updates.note") %></p>
              <a class="button secondary small" href="<%= spath("/topics/#{update.topic}") %>"><%= t("changelog.updates.open") %></a>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</main>

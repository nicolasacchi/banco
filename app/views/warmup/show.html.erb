<% content_for :title, t("warmup.title") %>
<main class="page" data-controller="warmup"
      data-warmup-tasks-url-value="<%= base_path %>/warmup/tasks"
      data-warmup-answer-url-value="<%= base_path %>/warmup/answers"
      data-warmup-complete-url-value="<%= base_path %>/warmup/complete"
      data-warmup-list-url-value="<%= preview? ? "#{base_path}/test" : base_path %>"
      data-warmup-texts-value="<%= student_texts.to_json %>">
  <h1><%= t("warmup.title") %></h1>
  <p><%= t("warmup.intro") %></p>
  <section class="card sitting-card" data-warmup-target="stage" hidden>
    <p class="step-line"><span class="pill info" data-warmup-target="step"></span></p>
    <div data-warmup-target="itemBox"></div>
    <div class="actions button-row sticky-actions">
      <button type="button" class="button" data-warmup-target="sendButton" data-action="warmup#send"><%= t("warmup.send") %></button>
      <button type="button" class="button secondary" data-warmup-target="unknownButton" data-action="warmup#dontKnow"><%= t("warmup.dont_know") %></button>
      <button type="button" class="button secondary" data-warmup-target="pauseButton" data-action="warmup#pause" hidden><%= t("sitting.pause") %></button>
      <button type="button" class="button secondary" data-warmup-target="resumeButton" data-action="warmup#resume" hidden><%= t("sitting.resume") %></button>
    </div>
    <p role="status" aria-live="polite" class="status" data-warmup-target="status"></p>
  </section>
  <section class="card" data-warmup-target="done" hidden>
    <h2 class="card-title"><%= ui_icon("circle-check") %> <%= t("warmup.done_title") %></h2>
    <p data-warmup-target="doneText"><%= t("warmup.done_text") %></p>
    <div class="button-row"><a class="button" href="<%= preview? ? "#{base_path}/test" : base_path %>"><%= t("sitting.back_to_list") %></a></div>
  </section>
</main>

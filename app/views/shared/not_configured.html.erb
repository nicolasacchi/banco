<!DOCTYPE html>
<html lang="it" data-theme="cream" data-size="normal">
  <head>
    <title><%= t("student.not_configured") %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= stylesheet_link_tag :app %>

<% mode = student_menu_mode %>
<% if mode == :sitting %>
  <nav class="student-menu" id="student-menu" aria-label="<%= t("student.menu.label") %>">
    <ul>
      <li><a id="sitting-leave" href="/today" data-sitting-leave><%= t("student.menu.pause_to_today") %></a></li>
      <li><button type="button" class="button secondary small" id="comment-open-menu" data-comment-open><%= t("comments.button") %></button></li>
    </ul>
  </nav>
<% elsif mode == :full %>
  <% current = student_menu_current %>
  <nav class="student-menu" id="student-menu" data-comment-anchor="menu" aria-label="<%= t("student.menu.label") %>">
    <ul>
      <% student_menu_items.each do |key, label, href| %>
        <li><a href="<%= href %>" id="<%= key == :logout ? 'logout-link' : "menu-#{key}" %>"<%= ' aria-current="page"'.html_safe if key == current %>><%= label %><% if key == :comments && comment_unread_count.positive? %> <span class="menu-badge" id="comments-badge" aria-label="<%= t("comments.menu_new", n: comment_unread_count) %>"><%= comment_unread_count %></span><% end %></a></li>
      <% end %>
      <li><button type="button" class="button secondary small" id="comment-open-menu" data-comment-open><%= t("comments.button") %></button></li>
    </ul>
  </nav>
<% end %>

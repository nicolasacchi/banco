<%# "Commenta" (D-304, look D-305): the comment mode's banner, the box and the confirmation, on every student page (not in the teacher's preview).
    comment_controller.js is the whole behaviour; the «Commenta» controls are the elements with data-comment-open. %>
<div id="comment-root" data-controller="comment"
     data-comment-url-value="/comments"
     data-comment-events-url-value="<%= comment_events_url %>"
     data-comment-page-path-value="<%= request.path %>"
     data-comment-labels-value="<%= comment_labels.to_json %>">
  <div class="comment-banner" id="comment-banner" role="region" aria-label="<%= t("comments.banner_title") %>" data-comment-target="banner" data-comment-ui hidden>
    <div class="comment-banner-in">
      <p class="comment-banner-title"><%= comment_icon("pick") %><strong><%= t("comments.banner_title") %></strong></p>
      <div class="comment-banner-actions">
        <button type="button" class="button small" id="comment-whole" data-action="comment#wholePage"><%= comment_icon("whole-page") %><%= t("comments.whole_page") %></button>
        <button type="button" class="button secondary small" id="comment-list" data-action="comment#chooseFromList"><%= t("comments.pick_list") %></button>
        <button type="button" class="button secondary small" id="comment-end" data-action="comment#cancel"><%= t("comments.cancel") %></button>
      </div>
    </div>
  </div>
  <dialog class="comment-box" id="comment-box" aria-labelledby="comment-box-title" data-comment-target="dialog" data-comment-ui data-action="close->comment#boxClosed">
    <form method="dialog" data-comment-target="form" data-action="submit->comment#send">
      <div class="comment-head">
        <h2 id="comment-box-title"><%= comment_icon("comment") %><%= t("comments.box_title") %></h2>
        <button type="button" class="comment-x" id="comment-close" aria-label="<%= t("comments.close") %>" data-action="comment#cancel"><%= comment_icon("close") %></button>
      </div>
      <p class="comment-clock" id="comment-clock-note" data-comment-target="clockNote" hidden><%= comment_icon("clock-paused") %><span><%= t("comments.clock_note") %></span></p>
      <div class="comment-place">
        <label for="comment-where"><%= t("comments.where") %></label>
        <select id="comment-where" class="answer-input wide" data-comment-target="where" data-action="change->comment#placeChanged"></select>
        <p class="comment-excerpt" data-comment-target="excerpt" hidden></p>
      </div>
      <p class="comment-selected" hidden>
        <span><%= t("comments.selected") %>: <q data-comment-target="selected"></q></span>
        <label class="option"><input type="checkbox" checked data-comment-target="includeSelected"> <span><%= t("comments.include_selected") %></span></label>
      </p>
      <fieldset class="comment-reasons">
        <legend><%= t("comments.reason_label") %></legend>
        <div class="comment-chips">
          <% Comment::REASONS.each do |reason| %>
            <label class="comment-chip" data-reason="<%= reason %>">
              <input type="radio" name="comment-reason" value="<%= reason %>" data-comment-target="reason">
              <%= comment_icon("reason-#{reason.dasherize}") %>
              <span class="comment-chip-text"><%= t("comments.reasons.#{reason}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <div class="comment-write">
        <label for="comment-text"><%= t("comments.text_label") %></label>
        <textarea id="comment-text" class="answer-input wide" rows="3" maxlength="<%= Comment::TEXT_MAX %>" placeholder="<%= t("comments.text_placeholder") %>" data-comment-target="text" data-action="input->comment#updateCount"></textarea>
        <span class="comment-count" data-comment-target="count"></span>
      </div>
      <p role="alert" class="comment-error" data-comment-target="status"></p>
      <div class="comment-footer">
        <button type="submit" class="button comment-send" id="comment-send"><%= comment_icon("send") %><%= t("comments.send") %></button>
        <button type="button" class="button secondary" id="comment-cancel" data-action="comment#cancel"><%= t("comments.cancel") %></button>
      </div>
    </form>
  </dialog>
  <p class="comment-toast" id="comment-toast" role="status" aria-live="polite" data-comment-target="toast"><%= comment_icon("circle-check") %><span data-comment-live></span></p>
</div>

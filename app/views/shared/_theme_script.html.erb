<%# "Automatico" (D-350): the theme follows the device. Runs in the head, before the first paint, so the page never flashes the wrong colours: with
    data-theme-choice="auto", data-theme is cream by day and dark by night, and changes when the device does. Any other choice is left alone. %>
<%= javascript_tag nonce: true do %>
  (function () {
    var root = document.documentElement, query = window.matchMedia("(prefers-color-scheme: dark)")
    function follow() { if (root.dataset.themeChoice === "auto") root.dataset.theme = query.matches ? "dark" : "cream" }
    follow()
    if (query.addEventListener) query.addEventListener("change", follow)
  })()
<% end %>

<!DOCTYPE html>
<html lang="it" data-theme="cream" data-size="normal">
  <head>
    <title><%= content_for(:title) || t("teacher.title") %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
    <link rel="stylesheet" href="/vendor/katex@0.19.0/katex.min.css">
    <%# No Turbo: forms are plain posts that redirect back. The one controller used here besides the item renderer is the heartbeat. %>
    <%= javascript_importmap_tags "diagnosis", importmap: student_importmap %>
  </head>
  <body class="student teacher" <% if @unit %>data-controller="activity" data-activity-url-value="/teacher/activity" data-activity-unit-value="<%= @unit %>"<% end %>>
    <nav class="teacher-nav" aria-label="<%= t('teacher.nav.label') %>">
      <a href="/teacher"><%= t("teacher.nav.home") %></a>
      <a href="/teacher/corrections"><%= t("teacher.nav.corrections") %></a>
      <a href="/teacher/preview"><%= t("teacher.preview.title") %></a>
    </nav>
    <% if notice %><p class="notice flash" role="status"><%= notice %></p><% end %>
    <% if alert %><p class="notice flash alert" role="alert"><%= alert %></p><% end %>
    <% if decision_blocker %><p class="notice"><%= t("teacher.cannot_decide.#{decision_blocker}") %></p><% end %>
    <%= yield %>
    <%= yield :ref_popovers %>
  </body>
</html>

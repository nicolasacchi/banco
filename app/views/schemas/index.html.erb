<%# «I miei schemi» (D-372): the schemas he has opened, by subject, and the number still closed in each. %>
<% content_for :title, t("schemas.title") %>
<main class="page course schemas-page" id="schemas-page">
  <h1><%= t("schemas.title") %></h1>
  <% if @closed %>
    <%= ui_notice :info, t("today.closed"), html: { id: "course-closed" } %>
  <% else %>
    <p class="schemas-intro" id="schemas-intro"><%= t("schemas.intro") %></p>
    <% if preview? %><%= ui_notice :info, t("schemas.preview_open"), html: { id: "schemas-preview-note" } %><% end %>
    <% unless @schemas.any_open? %><p id="schemas-empty"><%= t("schemas.empty") %></p><% end %>
    <% @schemas.groups.each do |group| %>
      <% subject = group.subject_view.subject %>
      <section class="schemas-subject" data-subject="<%= subject.key %>" aria-labelledby="schemas-<%= subject.key %>-title" style="--subject: var(--accent-<%= subject.key %>, var(--soft-primary))">
        <h2 class="schemas-subject-title cluster" id="schemas-<%= subject.key %>-title"><%= subject_chip(subject.key) %> <span><%= subject.name_it %></span></h2>
        <% if group.open.any? %>
          <ul class="row-list schemas-list">
            <% group.open.each do |entry| %>
              <li class="row" data-topic="<%= entry.topic.key %>" data-state="open">
                <div class="row-main">
                  <a class="row-stretch schema-link" href="<%= spath("/topics/#{entry.topic.key}/schema") %>" aria-label="<%= t("schemas.open_link", topic: entry.topic.title_it) %>"><%= entry.topic.title_it %></a>
                  <span class="topic-meta"><%= t("topic.kind.#{entry.topic.kind}") %></span>
                </div>
                <span class="row-end"><%= ui_icon("next", css: "row-chev") %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if group.locked_count.positive? %>
          <p class="schemas-locked muted" data-locked="<%= group.locked_count %>"><%= ui_icon("locked") %> <span><%= t("schemas.locked_count", count: group.locked_count) %>. <%= t(group.locked_count == 1 ? "schemas.locked" : "schemas.locked_many") %></span></p>
        <% end %>
      </section>
    <% end %>
  <% end %>
</main>

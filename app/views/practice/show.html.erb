<% content_for :title, @skill_label %>
<% clean = Practice::Messages.clean_count(@state.why) %>
<%# A skill of the english or spanish courses is named in the language it teaches, its Italian one tap away (D-402): the page is a translation scope of its own
    (the heading, the list's skill names, the closing screen's next topic); the exercise card inside keeps its own. %>
<% offered = @skill_label_translation.present? %>
<main class="page course practice" data-controller="practice" <%= tr_scope_attrs(offered, topic: @topic, surface: "practice") %>
      data-practice-topic-value="<%= @topic.key %>"
      data-practice-skill-value="<%= @skill %>"
      data-practice-base-url-value="<%= spath("/practice") %>"
      data-practice-back-url-value="<%= spath("/topics/#{@topic.key}") %>"
      data-practice-texts-value="<%= student_texts.to_json %>"
      data-practice-labels-value="<%= practice_labels.to_json %>">
  <header class="page-header">
    <a class="back" href="<%= spath("/topics/#{@topic.key}") %>"><%= ui_icon("back") %><%= t("practice.back") %></a>
    <h1 id="skill-name"<%= " lang=#{@topic.lang}".html_safe if offered %>><%= @skill_label %></h1>
    <%= tr_node(@skill_label_translation, tag: :p) if offered %>
  </header>
  <% if offered %><p class="tr-bar"><%= tr_page_button(offered) %></p><% end %>
  <% if draft? %><%= ui_notice :info, t("draft.notice"), html: { id: "draft-notice" } %><% end %>
  <div class="skill-status" data-comment-anchor="skill_status">
    <span class="pill <%= skill_state_tone(@state.state) %>" id="skill-state" data-practice-target="skillState"><%= Practice::Messages.skill_state_it(@state) %></span>
    <span class="dots" role="img" data-practice-target="dots" aria-label="<%= t("practice.clean_of", n: clean.to_i) %>"<%= ' hidden'.html_safe if clean.nil? %>>
      <% 3.times do |i| %><span class="<%= 'on' if clean.to_i > i %>"></span><% end %>
    </span>
    <span class="topic-why" id="skill-why" data-practice-target="skillWhy"><%= Practice::Messages.why_it(@state.why) %></span>
    <% missing = Practice::Messages.missing_it(@state.why) %>
    <span class="topic-why topic-missing" id="skill-missing" data-practice-target="skillMissing"<%= ' hidden'.html_safe unless missing %>><%= missing %></span>
  </div>
  <p class="paper-note"><%= ui_icon("step-practice") %><span><%= t("practice.paper") %></span></p>
  <div id="serve-reason" class="notice info" role="status" data-practice-target="reason" hidden>
    <%= ui_icon("info") %><div class="notice-body"></div>
  </div>

  <div class="practice-layout">
  <%# The list of the topic's exercises (D-337): drawn by the script from GET exercises?topic=. Open on a wide screen, closed on a phone. %>
  <aside class="exercise-list" id="exercise-list" data-comment-anchor="exercise_list" aria-labelledby="exercise-list-title" data-practice-target="list" hidden>
    <details class="disclosure exercise-panel" data-practice-target="listPanel">
      <summary>
        <span class="exercise-list-head">
          <span class="exercise-list-title" id="exercise-list-title"><%= t("practice.exercises") %></span>
          <span class="exercise-list-count" data-practice-target="listCount"></span>
        </span>
      </summary>
      <div class="exercise-groups" data-practice-target="listBody"></div>
    </details>
  </aside>

  <div class="practice-main">
  <%# The translation scope of a bilingual exercise (D-402): practice_controller.js turns it on for such a serve (data-tr-scope, data-tr-serve) and puts the
      «Traduzione» button in the action bar. Opening it is posted to /translations for the student; the preview writes nothing (no address). %>
  <div class="card exercise-card" data-practice-target="scope" data-tr-surface="practice" data-tr-topic="<%= @topic.key %>"<% unless preview? %> data-tr-url="<%= spath("/translations") %>"<% end %>>
    <section data-practice-target="work" aria-label="<%= t("practice.exercise") %>" hidden>
      <p class="reminder" id="reminder" data-practice-target="reminder" hidden></p>
      <div class="item" data-practice-target="itemBox" data-comment-anchor="exercise" data-action="item-change->practice#changed"></div>
      <div id="hints" class="notice hint" data-practice-target="hints" data-comment-anchor="hints" hidden>
        <%= ui_icon("wrong-hint") %>
        <div class="notice-body">
          <h2 class="notice-title"><%= t("practice.hints_title") %></h2>
          <ol data-practice-target="hintList"></ol>
        </div>
      </div>
      <div class="actions button-row sticky-actions" data-practice-target="controls">
        <button type="button" class="button" id="check" data-practice-target="check" data-action="practice#check"><%= t("practice.submit") %></button>
        <button type="button" class="button secondary" id="hint-button" data-practice-target="hintButton" data-action="practice#hint" hidden></button>
        <button type="button" class="button text" id="solution-button" data-practice-target="solutionButton" data-action="practice#solution"><%= t("practice.solution") %></button>
        <button type="button" class="button text" id="skip-button" data-practice-target="skip" data-action="practice#skip"><%= t("practice.skip") %></button>
      </div>
    </section>

    <div id="feedback" class="feedback" data-comment-anchor="feedback" role="status" aria-live="polite" tabindex="-1" data-practice-target="feedback"></div>
    <div id="solution" class="solution" data-comment-anchor="solution" data-practice-target="solutionBox" hidden></div>
    <div class="actions button-row" id="next-actions" data-practice-target="nextActions" hidden></div>
    <%# «Ti è piaciuto questo esercizio?» (D-365): under the exercise, shown by practice_controller.js once it is over; never in the preview. %>
    <% if rating_box? %><%= render "ratings/box", kind: "item", dom: "rating-box", hidden: true %><% end %>
    <%# The end of the topic (D-366): drawn by practice_controller.js from the `topic_done` reply instead of another exercise. It speaks of this topic only. %>
    <section class="topic-done" id="topic-done" data-practice-target="done" aria-labelledby="topic-done-title" hidden>
      <h2 id="topic-done-title" tabindex="-1" data-practice-target="doneTitle"></h2>
      <p id="topic-done-offer" data-practice-target="doneOffer" hidden></p>
      <div class="actions button-row" id="topic-done-actions" data-practice-target="doneActions"></div>
      <%# A slot after the buttons (D-373): practice_controller.js draws «Vedi lo schema» here, when the reply has the topic's schema. Empty before. %>
      <div class="topic-done-extra" id="topic-done-extra" data-practice-target="doneExtra"></div>
    </section>
  </div>
  <%= render "course/question", topic: @topic.key, lesson_revision_id: @topic.lesson_revision.id, section: "practice" %>
  </div>
  </div>
</main>

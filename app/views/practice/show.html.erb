<% content_for :title, @skill_label %>
<% clean = Practice::Messages.clean_count(@state.why) %>
<main class="page course practice" data-controller="practice"
      data-practice-topic-value="<%= @topic.key %>"
      data-practice-skill-value="<%= @skill %>"
      data-practice-serve-url-value="/practice/serves"
      data-practice-answer-url-value="/practice/answers"
      data-practice-back-url-value="/topics/<%= @topic.key %>"
      data-practice-texts-value="<%= student_texts.to_json %>"
      data-practice-labels-value="<%= practice_labels.to_json %>">
  <header class="page-header">
    <a class="back" href="/topics/<%= @topic.key %>"><%= ui_icon("back") %><%= t("practice.back") %></a>
    <h1 id="skill-name"><%= @skill_label %></h1>
  </header>
  <% if draft? %><%= ui_notice :info, t("draft.notice"), html: { id: "draft-notice" } %><% end %>
  <div class="skill-status">
    <span class="pill <%= skill_state_tone(@state.state) %>" id="skill-state" data-practice-target="skillState"><%= Practice::Messages.state_it(@state.state) %></span>
    <span class="dots" role="img" data-practice-target="dots" aria-label="<%= t("practice.clean_of", n: clean.to_i) %>"<%= ' hidden'.html_safe if clean.nil? %>>
      <% 3.times do |i| %><span class="<%= 'on' if clean.to_i > i %>"></span><% end %>
    </span>
    <span class="topic-why" id="skill-why" data-practice-target="skillWhy"><%= Practice::Messages.why_it(@state.why) %></span>
  </div>
  <p class="paper-note"><%= ui_icon("step-practice") %><span><%= t("practice.paper") %></span></p>
  <div id="serve-reason" class="notice info" role="status" data-practice-target="reason" hidden>
    <%= ui_icon("info") %><div class="notice-body"></div>
  </div>

  <div class="card exercise-card">
    <section data-practice-target="work" aria-label="<%= t("practice.exercise") %>" hidden>
      <div class="item" data-practice-target="itemBox" data-comment-anchor="exercise"></div>
      <div id="hints" class="notice hint" data-practice-target="hints" data-comment-anchor="hints" hidden>
        <%= ui_icon("wrong-hint") %>
        <div class="notice-body">
          <h2 class="notice-title"><%= t("practice.hints_title") %></h2>
          <ol data-practice-target="hintList"></ol>
        </div>
      </div>
      <div class="actions button-row sticky-actions" data-practice-target="controls">
        <button type="button" class="button" id="check" data-practice-target="check" data-action="practice#check"><%= t("practice.submit") %></button>
        <button type="button" class="button secondary" id="hint-button" data-practice-target="hintButton" data-action="practice#hint" hidden></button>
        <button type="button" class="button text" id="solution-button" data-practice-target="solutionButton" data-action="practice#solution"><%= t("practice.solution") %></button>
      </div>
    </section>

    <div id="feedback" class="feedback" data-comment-anchor="feedback" role="status" aria-live="polite" tabindex="-1" data-practice-target="feedback"></div>
    <div id="solution" class="solution" data-comment-anchor="solution" data-practice-target="solutionBox" hidden></div>
    <div class="actions button-row" id="next-actions" data-practice-target="nextActions" hidden></div>
  </div>
  <%= render "course/question", topic: @topic.key, lesson_revision_id: @topic.lesson_revision.id, section: "practice" %>
</main>

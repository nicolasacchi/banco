    {
     "args": [
      "2000"
     ],
     "result": "XX secolo d.C."
    },
    {
     "args": [
      "2001"
     ],
     "result": "XXI secolo d.C."
    },
    {
     "args": [
      "0"
     ],
     "refused": true
    },
    {
     "args": [
      "x"

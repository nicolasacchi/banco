{
 "version": 1,
 "description": "Shared vectors of Chrono (Ruby and JS). 'args' are strings as the schema holds them; 'result' is the canonical output (a whole number as its decimal text); 'refused': true is a call that raises (Ruby ArgumentError, JS RangeError) or, for parse_roman, gives nil/null. Invented from the calendar, checked by hand: -27 to 14 is 40, not 41.",
 "library": "chrono",
 "batch": "w2-1",
 "track": "T4a",
 "functions": {
  "duration": {
   "ruby": "duration(from, to)",
   "js": "duration(from, to)",
   "doc": "Whole years from one year to the other, the year 0 not counted: -27 to 14 is 40.",
   "cases": [
    {
     "args": [
      "-133",
      "-27"
     ],
     "result": "106"
    },
    {
     "args": [
      "-27",
      "14"
     ],
     "result": "40"
    },
    {
     "args": [
      "-1",
      "1"
     ],
     "result": "1"
    },
    {
     "args": [
      "-1",
      "-1"
     ],
     "result": "0"
    },
    {
     "args": [
      "1",
      "1"
     ],
     "result": "0"
    },
    {
     "args": [
      "1",
      "100"
     ],
     "result": "99"
    },
    {
     "args": [
      "-100",
      "-1"
     ],
     "result": "99"
    },
    {
     "args": [
      "-146",
      "-27"
     ],
     "result": "119"
    },
    {
     "args": [
      "-753",
      "476"
     ],
     "result": "1228"
    },
    {
     "args": [
      "-44",
      "14"
     ],
     "result": "57"
    },
    {
     "args": [
      "14",
      "-27"
     ],
     "result": "-40"
    },
    {
     "args": [
      "476",
      "1492"
     ],
     "result": "1016"
    },
    {
     "args": [
      "-509",
      "-27"
     ],
     "result": "482"
    },
    {
     "args": [
      "-2",
      "2"
     ],
     "result": "3"
    },
    {
     "args": [
      "0",
      "10"
     ],
     "refused": true
    },
    {
     "args": [
      "-10",
      "0"
     ],
     "refused": true
    },
    {
     "args": [
      "abc",
      "10"
     ],
     "refused": true
    },
    {
     "args": [
      "1.5",
      "10"
     ],
     "refused": true
    },
    {
     "args": [
      "",
      "10"
     ],
     "refused": true
    }
   ]
  },
  "century": {
   "ruby": "century(year)",
   "js": "century(year)",
   "doc": "The Italian label of a year's century: 'II secolo a.C.'.",
   "cases": [
    {
     "args": [
      "-133"
     ],
     "result": "II secolo a.C."
    },
    {
     "args": [
      "-27"
     ],
     "result": "I secolo a.C."
    },
    {

     ],
     "refused": true
    }
   ]
  },
  "mutants": {
   "ruby": "mutants(from, to)",
   "js": "mutants(from, to)",
   "doc": "The wrong values of duration that a typical error gives (year 0 counted, eras subtracted, same era added), by name.",
   "cases": [
    {
     "args": [
      "-27",
      "14"
     ],
     "result": {
      "year_zero_counted": "41",
      "eras_subtracted": "13"
     }
    },
    {
     "args": [
      "-133",
      "-27"
     ],
     "result": {
      "same_era_added": "160"
     }
    },
    {
     "args": [
      "-1",
      "1"
     ],
     "result": {
      "year_zero_counted": "2",
      "eras_subtracted": "0"
     }
    },
    {
     "args": [
      "14",
      "100"
     ],
     "result": {
      "same_era_added": "114"
     }
    },
    {
     "args": [
      "-44",
      "14"
     ],
     "result": {
      "year_zero_counted": "58",
      "eras_subtracted": "30"
     }
    },
    {
     "args": [
      "1",
      "1"
     ],
     "result": {
      "same_era_added": "2"
     }
    },
    {
     "args": [
      "0",
      "14"
     ],
     "refused": true
    }
   ]

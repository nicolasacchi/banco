#!/usr/bin/env ruby
# frozen_string_literal: true

# Compiles the vetted data tables of config/banco/data (D-269) into app/javascript/lesson/data/DOMAIN-NAME.js, after checking each against
# its JSON Schema. A table is config/banco/data/DOMAIN/NAME.yml with DOMAIN/NAME.schema.json beside it; a table that has not been written yet
# produces nothing (the tables are content, written by their tracks). The generated files are committed.
#   bin/build-lesson-data           write the files
#   bin/build-lesson-data --check   exit 1 when a table is invalid, a file differs from the build, or a generated file has no table (CI)
require "json"
require "yaml"

root = File.expand_path("..", __dir__)
ENV["BUNDLE_GEMFILE"] ||= File.join(root, "Gemfile")
require "bundler/setup"
require "json_schemer"
dir = File.join(root, "config/banco/data")
out_dir = File.join(root, "app/javascript/lesson/data")
header = "// GENERATED by bin/build-lesson-data from config/banco/data (D-269). Do not edit.\n"

outputs = {}
problems = []
Dir.glob("**/*.schema.json", base: dir).sort.each do |schema_file|
  name = schema_file.delete_suffix(".schema.json")
  table_file = File.join(dir, "#{name}.yml")
  next unless File.file?(table_file)

  data = YAML.safe_load_file(table_file, permitted_classes: [], aliases: false)
  errors = JSONSchemer.schema(JSON.parse(File.read(File.join(dir, schema_file)))).validate(data).first(3).map { |e| "#{e['data_pointer']} (#{e['type']})" }
  problems << "#{name}: #{errors.join(', ')}" unless errors.empty?
  outputs[File.join(out_dir, "#{name.tr('/', '-')}.js")] = "#{header}export default #{JSON.generate(data)}\n"
end

stale = Dir.exist?(out_dir) ? Dir.children(out_dir).map { |f| File.join(out_dir, f) } - outputs.keys : []
if ARGV.include?("--check")
  differ = outputs.reject { |path, text| File.exist?(path) && File.read(path) == text }.keys
  abort "build-lesson-data: #{(problems + differ + stale).first(3).join('; ')}" unless problems.empty? && differ.empty? && stale.empty?
  puts "build-lesson-data: #{outputs.size} tables compiled and current (#{Dir.glob('**/*.schema.json', base: dir).size} schemas)"
else
  abort "build-lesson-data: #{problems.join('; ')}" unless problems.empty?
  require "fileutils"
  FileUtils.mkdir_p(out_dir) unless outputs.empty?
  stale.each { |f| File.delete(f) }
  outputs.each { |path, text| File.write(path, text) }
  puts "build-lesson-data: wrote #{outputs.size} tables (#{Dir.glob('**/*.schema.json', base: dir).size} schemas)"
end

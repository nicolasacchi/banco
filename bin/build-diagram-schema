#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds app/javascript/lesson/diagram_schema.js from config/banco/schemas/diagram.json (D-247): the
# browser's diagram layouts check the shape of their data with the same schema Ruby uses, so a drawing
# never trusts data that Ruby would refuse (A7: layout never throws, it returns { error }). Descriptions
# are dropped to keep the file small.
#   bin/build-diagram-schema           write the file
#   bin/build-diagram-schema --check   exit 1 when the committed file differs from the build (CI)
require "json"

root = File.expand_path("..", __dir__)
schema = JSON.parse(File.read(File.join(root, "config/banco/schemas/diagram.json")))
strip = lambda do |value|
  case value
  when Hash then value.reject { |k, _| %w[description title $schema $id].include?(k) }.transform_values { |v| strip.call(v) }
  when Array then value.map { |v| strip.call(v) }
  else value
  end
end
out = "// GENERATED by bin/build-diagram-schema from config/banco/schemas/diagram.json. Do not edit.\nexport default #{JSON.generate(strip.call(schema))}\n"
target = File.join(root, "app/javascript/lesson/diagram_schema.js")

if ARGV.include?("--check")
  abort "build-diagram-schema: diagram_schema.js differs from the build (run bin/build-diagram-schema)" unless File.exist?(target) && File.read(target) == out
  puts "build-diagram-schema: diagram_schema.js matches diagram.json"
else
  File.write(target, out)
  puts "build-diagram-schema: wrote #{out.bytesize} bytes"
end

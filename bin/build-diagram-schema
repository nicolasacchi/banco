#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the browser's copies of config/banco/schemas/diagram.json (D-247, D-253): the diagram layouts check the shape
# of their data with the same schema Ruby uses, so a drawing never trusts data that Ruby would refuse (A7: layout never
# throws, it returns { error }). Descriptions are dropped to keep the files small.
#
#   app/javascript/lesson/diagram_schema.js            the types of release 1 (x-banco-release "1") and what they refer to
#   app/javascript/lesson/diagram_schemas/<type>.js    one file per wave 2 type: its definition and the helper definitions it
#                                                      refers to, so a lesson loads only the schemas of the types it uses (W2-0)
#
#   bin/build-diagram-schema           write the files
#   bin/build-diagram-schema --check   exit 1 when the committed files differ from the build (CI)
require "json"
require "fileutils"

root = File.expand_path("..", __dir__)
schema = JSON.parse(File.read(File.join(root, "config/banco/schemas/diagram.json")))
defs = schema.fetch("$defs")
strip = lambda do |value|
  case value
  when Hash then value.reject { |k, _| %w[description title $schema $id].include?(k) }.transform_values { |v| strip.call(v) }
  when Array then value.map { |v| strip.call(v) }
  else value
  end
end

# the names a value refers to with "#/$defs/NAME", followed transitively
closure = lambda do |value, seen = []|
  refs = []
  walk = lambda do |v|
    case v
    when Hash then v.each { |k, x| k == "$ref" && x.is_a?(String) && x.start_with?("#/$defs/") ? refs << x.delete_prefix("#/$defs/") : walk.call(x) }
    when Array then v.each { |x| walk.call(x) }
    end
  end
  walk.call(value)
  refs.uniq.each do |name|
    next if seen.include?(name)

    seen << name
    closure.call(defs.fetch(name), seen)
  end
  seen
end

types = defs.select { |_, d| d.is_a?(Hash) && d.key?("x-banco-kind") }
core = types.select { |_, d| d["x-banco-release"] == "1" }.keys
dispatch = ->(names) { names.map { |t| { "if" => { "properties" => { "type" => { "const" => t } }, "required" => [ "type" ] }, "then" => { "$ref" => "#/$defs/#{t}" } } } }
header = "// GENERATED by bin/build-diagram-schema from config/banco/schemas/diagram.json. Do not edit.\n"
outputs = {}

main_defs = (core + closure.call(core.map { |t| defs.fetch(t) })).uniq
# the main schema keeps the order of the source file
main = {
  "type" => "object", "required" => [ "type" ], "properties" => { "type" => { "enum" => core } }, "allOf" => dispatch.call(core),
  "$defs" => defs.slice(*defs.keys.select { |k| main_defs.include?(k) })
}
outputs["app/javascript/lesson/diagram_schema.js"] = "#{header}export default #{JSON.generate(strip.call(main))}\n"

(types.keys - core).each do |name|
  needed = closure.call(defs.fetch(name))
  doc = strip.call(defs.fetch(name)).merge("$defs" => strip.call(defs.slice(*defs.keys.select { |k| needed.include?(k) })))
  outputs["app/javascript/lesson/diagram_schemas/#{name}.js"] = "#{header}export default #{JSON.generate(doc)}\n"
end

dir = File.join(root, "app/javascript/lesson/diagram_schemas")
if ARGV.include?("--check")
  stale = Dir.exist?(dir) ? Dir.children(dir).map { |f| "app/javascript/lesson/diagram_schemas/#{f}" } - outputs.keys : []
  bad = outputs.reject { |path, text| File.exist?(File.join(root, path)) && File.read(File.join(root, path)) == text }.keys + stale
  abort "build-diagram-schema: #{bad.first(3).join(', ')} differ from the build (run bin/build-diagram-schema)" unless bad.empty?
  puts "build-diagram-schema: #{outputs.size} files match diagram.json"
else
  FileUtils.mkdir_p(dir)
  Dir.children(dir).each { |f| File.delete(File.join(dir, f)) unless outputs.key?("app/javascript/lesson/diagram_schemas/#{f}") }
  outputs.each { |path, text| File.write(File.join(root, path), text) }
  puts "build-diagram-schema: wrote #{outputs.size} files, #{outputs.values.sum(&:bytesize)} bytes"
end

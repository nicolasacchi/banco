#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the browser's registries from config/banco/lesson_types.yml (D-264):
#   app/javascript/lesson/diagrams/registry.js   the diagram types: the available ones imported eagerly (the nine of release 1
#                                                until their successors are built), every other type behind a lazy loader, the
#                                                status of each, the home palettes, and the layouts and views held back
#   app/javascript/lesson/checks/registry.js     the check components (lesson/checks/*) and options, the same way
#   app/javascript/lesson/voices.js              the accepted voices of config/banco/voices.yml (the voice gate of "Ascolta")
# The Ruby side reads the YAML directly (Lessons::Types), so there is nothing to generate for it.
#   bin/build-lesson-types           write the files
#   bin/build-lesson-types --check   exit 1 when the committed files differ from the build, or a module is missing (CI)
require "yaml"
require "json"

root = File.expand_path("..", __dir__)
types = YAML.safe_load_file(File.join(root, "config/banco/lesson_types.yml"))
header = "// GENERATED by bin/build-lesson-types from config/banco/lesson_types.yml (D-264). Do not edit.\n"
ident = ->(name) { name.tr("-", "_") }
missing = []
module_file = lambda do |path|
  file = File.join(root, "app/javascript", "#{path}.js")
  missing << path unless File.file?(file)
  path
end

# ---- diagrams
diagrams = types.fetch("diagrams")
eager = diagrams.select { |_, e| e["status"] == "available" }
lazy = diagrams.reject { |_, e| e["status"] == "available" }
reg = +header
reg << <<~JS
  // The diagram types of lesson/2 (A7, A8, WAVE2 1.2): type name -> module { layout, describe, ... }.
  // The available types are imported at once; the others are loaded on demand (`load`, `preload`): the page head carries a
  // modulepreload for each type the lesson uses, so a lesson with six types does not wait on six sequential imports.
JS
eager.each { |name, e| reg << %(import * as #{ident.call(name)} from "#{module_file.call(e.fetch('module'))}"\n) }
reg << %(import { run } from "lesson/diagrams/run"\n\n)
reg << "export const TYPES = { #{eager.keys.map { |n| ident.call(n) }.join(', ')} }\n"
reg << "export const STATUS = #{JSON.generate(diagrams.transform_values { |e| e.fetch('status') })}\n"
reg << "export const HOME_PALETTE = #{JSON.generate(diagrams.select { |_, e| e['home_palette'] }.transform_values { |e| e['home_palette'] })}\n"
reg << "export const FAMILY = #{JSON.generate(diagrams.transform_values { |e| e.fetch('family') })}\n"
reg << "export const HELD_BACK = #{JSON.generate(diagrams.select { |_, e| e['views'] }.transform_values { |e| e['views'].transform_values { |values| values.transform_values { |spec| spec.fetch('status') } } })}\n"
reg << "const LOADERS = {\n#{lazy.map { |name, e| %(  #{ident.call(name)}: () => import("#{module_file.call(e.fetch('module'))}")) }.join(",\n")}\n}\n"
reg << <<~JS

  const loaded = new Map()

  // The module of a type, loading it when needed; null for an unknown type.
  export async function load(type) {
    if (TYPES[type]) return TYPES[type]
    if (loaded.has(type)) return loaded.get(type)
    const loader = LOADERS[type]
    if (!loader) return null
    const mod = await loader()
    loaded.set(type, mod)
    return mod
  }

  export function preload(types) {
    return Promise.all([...new Set(types)].map(load))
  }

  export function moduleFor(type) {
    return TYPES[type] ?? loaded.get(type) ?? null
  }

  // layout(data, { width, fontPx, measure, subject, state, tryValue }) -> Scene | { error: { path, message, code } }
  export function layout(data, opts) {
    const mod = moduleFor(data?.type)
    if (mod) return mod.layout(data, opts)
    return run(data, opts, { build: () => ({ error: { path: "/type", message: "unknown diagram type", code: "E-LESSON-DIAGRAM" } }) })
  }

  export function describe(data) {
    const mod = moduleFor(data?.type)
    try {
      return mod ? mod.describe(data) : ""
    } catch (_error) {
      return ""
    }
  }

  export function stateCount(data) {
    return Array.isArray(data?.states) && data.states.length > 0 ? data.states.length : 1
  }
JS

# ---- checks
checks = types.fetch("checks")
creg = +header
creg << <<~JS
  // The check components of lesson/2 (WAVE2 2.11) and their options. The six of release 1 live in lesson/blocks/check; the
  // others are modules of lesson/checks, loaded on demand.
  export const COMPONENTS = #{JSON.generate(checks.transform_values { |e| e.slice('status', 'batch').merge('module' => e.fetch('module')) })}
  export const OPTIONS = #{JSON.generate(types.fetch('check_options'))}
  const LOADERS = {
JS
creg << checks.select { |_, e| e["module"].start_with?("lesson/checks/") }.map { |name, e| %(    #{name}: () => import("#{module_file.call(e['module'])}")) }.join(",\n") << "\n  }\n"
creg << <<~JS

  export function isAvailable(component) {
    return COMPONENTS[component]?.status === "available"
  }

  const loaded = new Map()

  // The module of a component of lesson/checks, loading it when needed; null for the built-in ones and unknown names.
  export async function load(component) {
    if (loaded.has(component)) return loaded.get(component)
    const loader = LOADERS[component]
    if (!loader) return null
    const mod = await loader()
    loaded.set(component, mod)
    return mod
  }

  export function preload(components) {
    return Promise.all([...new Set(components)].map(load))
  }

  // The module of a component that has been loaded (preload before the page is drawn), or null.
  export function moduleFor(component) {
    return loaded.get(component) ?? null
  }
JS

voices = YAML.safe_load_file(File.join(root, "config/banco/voices.yml"))
vjs = "#{header}export default #{JSON.generate(voices.slice('accepted', 'preference', 'rates'))}\n"

outputs = { "app/javascript/lesson/diagrams/registry.js" => reg, "app/javascript/lesson/checks/registry.js" => creg, "app/javascript/lesson/voices.js" => vjs }
abort "build-lesson-types: modules missing: #{missing.uniq.join(', ')}" unless missing.empty?
if ARGV.include?("--check")
  bad = outputs.reject { |path, text| File.exist?(File.join(root, path)) && File.read(File.join(root, path)) == text }.keys
  abort "build-lesson-types: #{bad.join(', ')} differ from the build (run bin/build-lesson-types)" unless bad.empty?
  puts "build-lesson-types: the registries match lesson_types.yml (#{diagrams.size} diagram types, #{checks.size} checks)"
else
  outputs.each { |path, text| File.write(File.join(root, path), text) }
  puts "build-lesson-types: wrote #{outputs.size} files (#{eager.size} eager, #{lazy.size} lazy diagram types)"
end

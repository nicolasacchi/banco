#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds app/assets/stylesheets/lesson_roles.css from config/banco/lesson_palette.yml (D-246, A6).
# Offline and deterministic. The colours are custom properties set on the theme element
# ([data-theme="cream"], [data-theme="dark"]), so a theme switched on a box inside a page (the teacher's
# preview) wins over the page's own theme: a custom property is inherited from the nearest ancestor that
# sets it. The classes use them: .role-NAME (text, formulas), .mk-NAME (marks of diagrams), .tn-NAME (tint).
#   bin/build-palette           write the file
#   bin/build-palette --check   exit 1 when the committed file differs from the build (CI)
require "yaml"

root = File.expand_path("..", __dir__)
palette = YAML.safe_load_file(File.join(root, "config/banco/lesson_palette.yml"))
target = File.join(root, "app/assets/stylesheets/lesson_roles.css")

themes = %w[cream dark]
roles = {} # name => role hash, in file order, the first definition of a name wins
palette.fetch("common").each { |name, role| roles[name] = role }
%w[math italian].each { |subject| palette.fetch(subject).fetch("roles").each { |name, role| roles[name] ||= role } }
accents = %w[math italian].to_h { |subject| [ subject, palette.fetch(subject).fetch("accent") ] }

vars = lambda do |theme|
  lines = []
  roles.each do |name, role|
    %w[fg mark tint].each { |k| lines << "  --r-#{name}-#{k}: #{role[k][theme]};" if role[k] }
  end
  accents.each { |subject, accent| lines << "  --accent-#{subject}: #{accent['tint'][theme]};" }
  lines.join("\n")
end

out = +"/* GENERATED by bin/build-palette from config/banco/lesson_palette.yml (D-246). Do not edit. */\n"
out << ":root,\n[data-theme=\"cream\"] {\n#{vars.call('cream')}\n}\n"
out << "[data-theme=\"dark\"] {\n#{vars.call('dark')}\n}\n"
out << "@media print {\n  :root,\n  [data-theme] {\n#{vars.call('cream').gsub(/^/, '  ')}\n  }\n}\n"
out << "\n/* Text and formulas: colour, and a tint where the place says the role. */\n"
roles.each do |name, role|
  rules = []
  rules << "color: var(--r-#{name}-fg);" if role["fg"]
  rules << "background: var(--r-#{name}-tint);" if %w[position tint].include?(role["carrier"])
  rules << "border-radius: 0.2em; padding: 0 0.15em;" if %w[position tint].include?(role["carrier"])
  out << ".role-#{name} { #{rules.join(' ')} }\n" unless rules.empty?
end
out << "\n/* Marks of diagrams: shape and stroke. */\n"
roles.each do |name, role|
  next unless role["mark"]

  out << ".mk-#{name} { fill: var(--r-#{name}-mark); stroke: var(--r-#{name}-mark); color: var(--r-#{name}-fg); }\n"
end
out << "\n/* Tints for areas (the two members of an equation, a card's tone). */\n"
roles.each do |name, role|
  out << ".tn-#{name} { background: var(--r-#{name}-tint); }\n" if role["tint"]
end
out << "\n/* The subject's header band (the card's `tone` takes a role's tint instead). */\n"
accents.each_key { |subject| out << ".lesson[data-subject=\"#{subject}\"] { --band: var(--accent-#{subject}); }\n" }
roles.each { |name, role| out << ".card-tone-#{name} { --band: var(--r-#{name}-tint); }\n" if role["tint"] }

if ARGV.include?("--check")
  abort "build-palette: lesson_roles.css differs from the build (run bin/build-palette)" unless File.exist?(target) && File.read(target) == out
  puts "build-palette: lesson_roles.css matches lesson_palette.yml (#{roles.size} roles)"
else
  File.write(target, out)
  puts "build-palette: wrote #{roles.size} roles, #{out.bytesize} bytes"
end

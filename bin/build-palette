#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds app/assets/stylesheets/lesson_roles.css and app/javascript/lesson/palette.js from config/banco/lesson_palette.yml
# (D-246, A6; version 2, D-264: every subject, scoped by subject). Offline and deterministic.
#
# The colours are custom properties set on the theme element ([data-theme="cream"], [data-theme="dark"]), so a theme
# switched on a box inside a page (the teacher's preview) wins over the page's own theme: a custom property is inherited
# from the nearest ancestor that sets it. They are scoped by subject: --r-SUBJECT-ROLE-(fg|mark|tint); `common` roles are
# --r-common-ROLE-*. The classes (.role-NAME for text and formulas, .mk-NAME for the marks of diagrams, .tn-NAME for a
# tint, .fl-/.st- for fills and strokes, .card-tone-NAME) read the generic --role-NAME-* variables, which each palette
# element ([data-palette="SUBJECT"]: the lesson's root, or a figure of a type with a home palette) maps to its own
# subject's variables. So the nearest palette ancestor decides, two subjects may use the same role name for different
# things, and a figure of another subject's home palette (a balance on a computer science card) keeps its own colours.
# A role with `same_as` maps to the variables of the role it copies.
#   bin/build-palette           write the files
#   bin/build-palette --check   exit 1 when the committed files differ from the build (CI)
require "yaml"
require "json"

root = File.expand_path("..", __dir__)
palette = YAML.safe_load_file(File.join(root, "config/banco/lesson_palette.yml"))
icons = YAML.safe_load_file(File.join(root, "config/banco/icons.yml"))
target = File.join(root, "app/assets/stylesheets/lesson_roles.css")

common = palette.fetch("common")
subjects = palette.keys - %w[version rules common step_tags]

# Each subject's roles with same_as resolved: name => [owner subject, owner role, definition (the owner's, with own label/question)]
resolved = subjects.to_h do |subject|
  roles = palette.fetch(subject).fetch("roles").to_h do |name, role|
    if role["same_as"]
      owner_subject, owner_role = role["same_as"].split(".")
      owner = palette.fetch(owner_subject).fetch("roles").fetch(owner_role)
      abort "build-palette: #{subject}.#{name} copies #{role['same_as']}, which is itself a copy" if owner["same_as"]
      [ name, [ owner_subject, owner_role, owner.merge(role.slice("label_it", "question_it")) ] ]
    else
      [ name, [ subject, name, role ] ]
    end
  end
  [ subject, roles ]
end

# every definition that owns colours: ["common", name] and [subject, name]
owned = []
common.each { |name, role| owned << [ "common", name, role ] }
subjects.each { |subject| palette.fetch(subject).fetch("roles").each { |name, role| owned << [ subject, name, role ] unless role["same_as"] } }

vars = lambda do |theme|
  lines = []
  owned.each do |subject, name, role|
    %w[fg mark tint].each { |k| lines << "  --r-#{subject}-#{name}-#{k}: #{role[k][theme]};" if role[k] }
  end
  subjects.each { |subject| lines << "  --accent-#{subject}: #{palette.fetch(subject).fetch('accent')['tint'][theme]};" }
  common.each do |name, role|
    %w[fg mark tint].each { |k| lines << "  --role-#{name}-#{k}: var(--r-common-#{name}-#{k});" if role[k] }
    lines << "  --role-#{name}-bg: var(--r-common-#{name}-tint); --role-#{name}-pad: 0 0.15em; --role-#{name}-radius: 0.2em;" if %w[position tint].include?(role["carrier"])
  end
  lines.join("\n")
end

out = +"/* GENERATED by bin/build-palette from config/banco/lesson_palette.yml (D-246, version #{palette['version']}). Do not edit. */\n"
out << ":root,\n[data-theme=\"cream\"] {\n#{vars.call('cream')}\n}\n"
out << "[data-theme=\"dark\"] {\n#{vars.call('dark')}\n}\n"
out << "@media print {\n  :root,\n  [data-theme] {\n#{vars.call('cream').gsub(/^/, '  ')}\n  }\n}\n"

# the union of the role names, with the properties some subject gives them
names = {}
common.each { |name, role| (names[name] ||= []) << role }
resolved.each_value { |roles| roles.each { |name, (_, _, role)| (names[name] ||= []) << role } }
placed = ->(role) { %w[position tint].include?(role["carrier"]) }
tinted_names = names.select { |_, defs| defs.any?(&placed) }.keys

out << "\n/* The roles of a palette element: a lesson's root and a figure of a home palette map the generic names to their subject's. */\n"
subjects.each do |subject|
  lines = []
  resolved.fetch(subject).each do |name, (owner, owner_role, role)|
    %w[fg mark tint].each { |k| lines << "  --role-#{name}-#{k}: var(--r-#{owner}-#{owner_role}-#{k});" if role[k] }
    next unless tinted_names.include?(name)

    if placed.call(role)
      lines << "  --role-#{name}-bg: var(--r-#{owner}-#{owner_role}-tint); --role-#{name}-pad: 0 0.15em; --role-#{name}-radius: 0.2em;"
    else
      lines << "  --role-#{name}-bg: none; --role-#{name}-pad: 0; --role-#{name}-radius: 0;"
    end
  end
  out << "[data-palette=\"#{subject}\"] {\n#{lines.join("\n")}\n}\n"
end
# the common roles with a tint (highlight): on the theme element, like their colours
out << "\n/* Text and formulas: colour, and a tint where the place says the role. */\n"
names.each do |name, defs|
  rules = []
  rules << "color: var(--role-#{name}-fg);" if defs.any? { |r| r["fg"] }
  if tinted_names.include?(name)
    rules << "background: var(--role-#{name}-bg, none); border-radius: var(--role-#{name}-radius, 0); padding: var(--role-#{name}-pad, 0);"
  end
  out << ".role-#{name} { #{rules.join(' ')} }\n" unless rules.empty?
end
out << "\n/* Marks of diagrams: shape and stroke. */\n"
names.each do |name, defs|
  next unless defs.any? { |r| r["mark"] }

  out << ".mk-#{name} { fill: var(--role-#{name}-mark); stroke: var(--role-#{name}-mark); color: var(--role-#{name}-fg); }\n"
end
out << "\n/* Fills of shapes: tint areas and the strokes of outlines. */\n"
names.each do |name, defs|
  out << ".fl-#{name} { fill: var(--role-#{name}-tint); }\n" if defs.any? { |r| r["tint"] }
  out << ".st-#{name} { stroke: var(--role-#{name}-mark); fill: none; }\n" if defs.any? { |r| r["mark"] }
end
out << "\n/* Tints for areas (the two members of an equation, a card's tone). */\n"
names.each do |name, defs|
  out << ".tn-#{name} { background: var(--role-#{name}-tint); }\n" if defs.any? { |r| r["tint"] }
end
out << "\n/* The subject's header band (the card's `tone` takes a role's tint instead). */\n"
subjects.each { |subject| out << ".l2[data-subject=\"#{subject}\"] { --band: var(--accent-#{subject}); }\n" }
names.each { |name, defs| out << ".card-tone-#{name} { --band: var(--role-#{name}-tint); }\n" if defs.any? { |r| r["tint"] } }

# The same roles for the browser's code: names, labels, carriers, icons, shapes, questions and step tags (no colours),
# the sprite of every icon, the centre role of a sentence and the home palettes a subject embeds.
pick = ->(role) { role.slice("label_it", "carrier", "icon", "shape", "question_it") }
sprite_of = {}
icons.fetch("structural").each_key { |n| sprite_of[n] = "banco-sprite.svg" }
icons.fetch("ui").each_key { |n| sprite_of[n] ||= "banco-sprite.svg" }
icons.fetch("subjects").each { |subject, list| list.each_key { |n| sprite_of[n] ||= "banco-sprite-#{subject}.svg" } }
data = {
  "version" => palette["version"],
  "common" => common.transform_values(&pick),
  "subjects" => resolved.transform_values { |roles| roles.transform_values { |(_, _, role)| pick.call(role) } },
  "centre" => subjects.to_h { |s| [ s, palette.fetch(s)["centre_role"] ] }.compact,
  "embeds" => subjects.to_h { |s| [ s, palette.fetch(s)["embeds"] ] }.compact,
  "step_tags" => palette.fetch("step_tags"),
  # the icons an agent may name (E-LESSON-ICON): the structural list plus the subject's list
  "icons" => { "structural" => icons.fetch("structural").keys, "ui" => icons.fetch("ui").keys, "subjects" => icons.fetch("subjects").transform_values(&:keys), "sprites" => sprite_of }
}
js_target = File.join(root, "app/javascript/lesson/palette.js")
js = "// GENERATED by bin/build-palette from config/banco/lesson_palette.yml (D-246). Do not edit.\nexport default #{JSON.generate(data)}\n"

if ARGV.include?("--check")
  ok = File.exist?(target) && File.read(target) == out && File.exist?(js_target) && File.read(js_target) == js
  abort "build-palette: lesson_roles.css or palette.js differs from the build (run bin/build-palette)" unless ok
  puts "build-palette: lesson_roles.css matches lesson_palette.yml (#{names.size} role names, #{subjects.size} subjects)"
else
  File.write(target, out)
  File.write(js_target, js)
  puts "build-palette: wrote #{names.size} role names for #{subjects.size} subjects, #{out.bytesize} bytes"
end

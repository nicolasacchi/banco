#!/bin/sh
# Release build of the banco CLI: linux, darwin and windows, amd64 and arm64, into dist/ with SHA256SUMS and build.json
# ({version, built_at}: what GET /api/v1/updates reports, D-330).
# The version is stamped from git: <base>+<short commit>, with ".dirty" when cli/ or contract/ has uncommitted changes;
# where there is no .git (the Dockerfile's cli stage) GIT_SHA=<commit> gives the commit.
# Each binary embeds contract/commands.json, so it only talks to a server of the same contract (X-Banco-Contract).
#
#   bin/build-cli-dist            # dist/banco-<os>-<arch>[.exe], dist/SHA256SUMS and dist/build.json
#   DIST_DIR=/tmp/out bin/build-cli-dist
#   GIT_SHA=0123abcd... DIST_DIR=/dist bin/build-cli-dist   # the image's build
#
# On the bot's machine: check the sum, make it executable, then
#   export BANCO_URL=https://api.banco.scc.im BANCO_TOKEN=bnc_...; banco version; banco teacher home
set -eu

cd "$(dirname "$0")/.."
out="${DIST_DIR:-dist}"

base=$(sed -n 's/^var version = "\([^"]*\)".*/\1/p' cli/main.go)
[ -n "$base" ] || { echo "build-cli-dist: no 'var version' in cli/main.go" >&2; exit 1; }
if [ -n "${GIT_SHA:-}" ] && [ "$GIT_SHA" != unknown ]; then
  rev=$(printf '%.12s' "$GIT_SHA")
else
  rev=$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
  if [ "$rev" != unknown ] && [ -n "$(git status --porcelain -- cli contract go.mod 2>/dev/null)" ]; then
    rev="$rev.dirty"
  fi
fi
version="$base+$rev"

(cd cli && go test ./... >/dev/null) || { echo "build-cli-dist: the CLI tests fail; nothing built" >&2; exit 1; }

rm -rf "$out"
mkdir -p "$out"
for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64; do
  os=${target%/*}
  arch=${target#*/}
  ext=""
  [ "$os" = windows ] && ext=".exe"
  name="banco-$os-$arch$ext"
  CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath -buildvcs=false -ldflags "-s -w -X main.version=$version" -o "$out/$name" ./cli
  echo "built $out/$name"
done

if command -v sha256sum >/dev/null 2>&1; then
  (cd "$out" && sha256sum banco-* > SHA256SUMS)
else
  (cd "$out" && shasum -a 256 banco-* > SHA256SUMS)
fi
printf '{"version":"%s","built_at":"%s"}\n' "$version" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$out/build.json"
echo "version $version"
echo "checksums in $out/SHA256SUMS"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banco.page/1",
  "description": "The manifest (page.json) of a free page, release 2 (D-289, SPEC B2). The key is SUBJECT.slug; the checks that need the files or the rules (word counts, readability, the libraries the server vendors) are made in Ruby (Validation::PageChecks).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "key",
    "subject",
    "title_it",
    "why_free_it",
    "instructions_it",
    "alt_it",
    "fallback_it",
    "libs",
    "bridge",
    "aspect",
    "min_height",
    "uses_seed",
    "reduced_motion",
    "webgl",
    "roles"
  ],
  "properties": {
    "schema": {
      "const": "banco.page/1"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "maxLength": 40
    },
    "title_it": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "why_free_it": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "description": "Why components are not enough (the reviewer checks it)."
    },
    "instructions_it": {
      "type": "string",
      "minLength": 5,
      "maxLength": 400,
      "description": "At most 40 words, checked in Ruby."
    },
    "alt_it": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600,
      "description": "5 to 60 words, checked in Ruby."
    },
    "fallback_it": {
      "type": "string",
      "minLength": 40,
      "maxLength": 700,
      "description": "10 to 80 words, checked in Ruby."
    },
    "libs": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+(:[A-Za-z0-9_./-]+)?$",
        "maxLength": 100
      }
    },
    "bridge": {
      "const": 1
    },
    "aspect": {
      "enum": [
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "21:9"
      ]
    },
    "min_height": {
      "type": "integer",
      "minimum": 160,
      "maximum": 900
    },
    "uses_seed": {
      "type": "boolean"
    },
    "reduced_motion": {
      "enum": [
        "static",
        "none"
      ],
      "description": "static: a still state under reduced motion; none: the page has no motion."
    },
    "webgl": {
      "type": "boolean"
    },
    "roles": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 40
      }
    }
  }
}

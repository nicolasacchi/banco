{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banco.lesson/1",
  "description": "The parsed body of a lesson (what lesson_revisions.body_json stores). The author writes lesson.md; its front matter is $defs.front_matter (violations are E-SCHEMA with path /front_matter/...).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "key",
    "kind",
    "subject",
    "title_it",
    "skills",
    "uses",
    "refs",
    "scope",
    "minutes",
    "calculator",
    "sections",
    "try_intro_it",
    "exercises"
  ],
  "properties": {
    "schema": {
      "const": "banco.lesson/1"
    },
    "schema_version": {
      "const": 1
    },
    "key": {
      "$ref": "#/$defs/lesson_key"
    },
    "kind": {
      "enum": [
        "ripasso",
        "ponte",
        "lezione"
      ]
    },
    "subject": {
      "enum": [
        "math",
        "italian",
        "english",
        "spanish",
        "history",
        "geography",
        "law_economics",
        "business",
        "computer_science",
        "biology",
        "chemistry"
      ]
    },
    "title_it": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_key"
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "uses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_key"
      },
      "maxItems": 6,
      "uniqueItems": true
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 1,
      "maxItems": 12
    },
    "scope": {
      "enum": [
        "studied",
        "integration_studied",
        "in_progress",
        "middle_school",
        "not_in_prima",
        "seconda"
      ]
    },
    "minutes": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "calculator": {
      "type": "boolean"
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "why_it",
        "idea_it",
        "example_it",
        "mistakes_it",
        "book_it",
        "summary_it"
      ],
      "properties": {
        "why_it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "idea_it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "example_it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "mistakes_it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "book_it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "summary_it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      }
    },
    "try_intro_it": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      ]
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "text_it",
          "solution_it",
          "final_it"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "text_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "solution_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "final_it": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "skill_key": {
      "type": "string",
      "pattern": "^(math|italian|english|spanish|history|geography|law_economics|business|computer_science|biology|chemistry)\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lesson_key": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^(ripasso|ponte|lezione)\\.(math|italian|english|spanish|history|geography|law_economics|business|computer_science|biology|chemistry)\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "line",
        "fragment",
        "role"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "fragment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "role": {
          "enum": [
            "taught_in",
            "needed_by"
          ]
        }
      }
    },
    "front_matter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "key",
        "kind",
        "subject",
        "title_it",
        "skills",
        "refs",
        "scope",
        "minutes",
        "calculator",
        "finals_it"
      ],
      "properties": {
        "schema": {
          "const": "banco.lesson/1"
        },
        "key": {
          "$ref": "#/$defs/lesson_key"
        },
        "kind": {
          "enum": [
            "ripasso",
            "ponte",
            "lezione"
          ]
        },
        "subject": {
          "enum": [
            "math",
            "italian",
            "english",
            "spanish",
            "history",
            "geography",
            "law_economics",
            "business",
            "computer_science",
            "biology",
            "chemistry"
          ]
        },
        "title_it": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill_key"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill_key"
          },
          "maxItems": 6,
          "uniqueItems": true
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "scope": {
          "enum": [
            "studied",
            "integration_studied",
            "in_progress",
            "middle_school",
            "not_in_prima",
            "seconda"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "calculator": {
          "type": "boolean"
        },
        "finals_it": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}

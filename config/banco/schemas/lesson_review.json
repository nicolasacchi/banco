        "type": "object",
        "additionalProperties": false,
        "required": [
          "where",
          "n",
          "expression",
          "value"
        ],
        "properties": {
          "where": {
            "enum": [
              "example",
              "try",
              "solutions",
              "idea",
              "mistakes",
              "check"
            ]
          },
          "n": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "quote",
          "problem_it",
          "fix_it"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "section": {
            "enum": [
              "why",
              "idea",
              "example",
              "mistakes",
              "try",
              "solutions",
              "book",
              "summary",
              "frontmatter"
            ],
            "description": "lesson/1 only."
          },
          "exercise": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "problem_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "fix_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "card": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30,
            "description": "lesson/2 only: the n of the card; 0 is the cover (front matter)."
          },
          "block": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "lesson/2 only: the n of the block in the card."
          }
        },
        "oneOf": [
          {
            "required": [
              "section"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "card"
                  ]
                },
                {
                  "required": [
                    "block"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "card"
            ],
            "not": {
              "required": [
                "section"
              ]
            }
          }
        ]
      }
    }
  },
  "description": "A review of a lesson revision. A lesson/1 revision has exactly 8 checklist points and findings by section; a lesson/2 revision has 11 points and findings by card (card 0 is the cover). The count that fits the revision is E-REVIEW-CHECKLIST, checked in Ruby (Review::LessonChecklist); the schema allows 8 to 11."
}

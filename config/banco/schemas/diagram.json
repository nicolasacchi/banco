{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:schema:diagram",
  "title": "banco.diagram/1",
  "description": "One drawing of a lesson/2: a diagram (A7) or a schema (A8), release 1 types. Agents write this data, our templates draw it. 'x-banco-state-keys' lists the keys a state may carry; 'x-banco-solution' marks a solution field that is never served to the browser as such.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "equation_parts",
        "number_line",
        "balance",
        "area_model",
        "cartesian",
        "sentence",
        "concept_map",
        "flow",
        "table"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "equation_parts"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/equation_parts"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "number_line"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/number_line"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "balance"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/balance"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "area_model"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/area_model"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cartesian"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/cartesian"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "sentence"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/sentence"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "concept_map"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/concept_map"

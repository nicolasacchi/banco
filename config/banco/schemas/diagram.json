  "$defs": {
    "alt_it": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "Text alternative, 5 to 50 words (E-LESSON-ALT, checked in Ruby)."
    },
    "caption_it": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "size": {
      "enum": [
        "s",
        "m",
        "l"
      ]
    },
    "num": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$|^-?(0|[1-9][0-9]*)/[1-9][0-9]*$",
      "description": "An exact number: an integer, a decimal with comma, or a fraction a/b with b > 0 (Lessons::Num, lesson/num.js)."
    },
    "num_or_inf": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$|^-?(0|[1-9][0-9]*)/[1-9][0-9]*$|^(-inf|\\+inf)$",
      "description": "A num, or -inf / +inf (number_line intervals only)."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z]+(-[a-z]+)*$",
      "description": "A colour role of the lesson's subject palette (E-LESSON-ROLE, checked in Ruby)."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Plain text or text with $...$; at most 6 words (checked in Ruby)."
    },
    "natural": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "plate": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        }
      }
    },
    "equation_parts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "alt_it",
        "parts"
      ],
      "properties": {
        "type": {
          "const": "equation_parts"
        },
        "alt_it": {
          "$ref": "#/$defs/alt_it"
        },
        "caption_it": {
          "$ref": "#/$defs/caption_it"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tex",
              "role"
            ],
            "properties": {
              "tex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "role": {
                "$ref": "#/$defs/role"
              },
              "label_it": {
                "$ref": "#/$defs/label"
              }
            }
          },
          "minItems": 2,
          "maxItems": 9
        },
        "brackets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "label_it"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "to": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "label_it": {
                "$ref": "#/$defs/label"
              },
              "role": {
                "$ref": "#/$defs/role"
              }
            }
          },
          "minItems": 0,
          "maxItems": 4
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "brackets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to",
                    "label_it"
                  ],
                  "properties": {
                    "from": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 8
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 8
                    },
                    "label_it": {
                      "$ref": "#/$defs/label"
                    },
                    "role": {
                      "$ref": "#/$defs/role"
                    }
                  }
                },
                "minItems": 0,
                "maxItems": 4
              }
            }
          },
          "minItems": 2,
          "maxItems": 6,
          "description": "Each state overlays the top level, shallowly (A7); at most 6."
        }
      },
      "x-banco-kind": "diagram",
      "x-banco-release": "1",
      "x-banco-state-keys": [
        "brackets"
      ],
      "description": "The anatomy of an equation: its parts in order (members and the = sign) and brackets over whole parts."
    },

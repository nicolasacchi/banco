{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "banco.course/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "subject",
    "skills",
    "topics"
  ],
  "properties": {
    "schema": {
      "const": "banco.course/1"
    },
    "schema_version": {
      "const": 1
    },
    "subject": {
      "enum": [
        "math",
        "italian",
        "english",
        "spanish",
        "history",
        "geography",
        "law_economics",
        "business",
        "computer_science",
        "biology",
        "chemistry"
      ]
    },
    "notes_it": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/course_skill"
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/topic_entry"
      }
    }
  },
  "$defs": {
    "skill_key": {
      "type": "string",
      "pattern": "^(math|italian|english|spanish|history|geography|law_economics|business|computer_science|biology|chemistry)\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lesson_key": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^(ripasso|ponte|lezione)\\.(math|italian|english|spanish|history|geography|law_economics|business|computer_science|biology|chemistry)\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "line",
        "fragment",
        "role"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "fragment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "role": {
          "enum": [
            "taught_in",
            "needed_by"
          ]
        }
      }
    },
    "course_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label_it",
        "layer",
        "prerequisites",
        "refs",
        "errors"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/skill_key"
        },
        "label_it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "layer": {
          "enum": [
            "core",
            "sec",
            "opt"
          ]
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skill_key"
          }
        },
        "composite_of": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skill_key"
          }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "description_it",
              "implicates"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
              },
              "description_it": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "implicates": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/skill_key"
                }
              }
            }
          }
        }
      }
    },
    "topic_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "title_it",
        "term",
        "minutes",
        "skills",
        "after"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/lesson_key"
        },
        "kind": {
          "enum": [
            "ripasso",
            "ponte",
            "lezione"
          ]
        },
        "title_it": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "term": {
          "enum": [
            1,
            2,
            3,
            null
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 90
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skill_key"
          }
        },
        "after": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lesson_key"
          }
        }
      }
    }
  }
}

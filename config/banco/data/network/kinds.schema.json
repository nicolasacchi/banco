{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:network-kinds",
  "title": "banco data table network/kinds",
  "description": "The edge kinds of a network (owes, pays, elects, trusts, appoints, commands, advises, votes_laws, vetoes, orders, promises, gives, sends) with label, icon and arrow style, and the objects an arrow carries. Each value carries its source; a second table typed separately by another session is compared by the unit test; changed only by a D entry (WAVE2 1.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kinds",
    "what"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_()-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label_it",
          "icon",
          "arrow"
        ],
        "properties": {
          "label_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "arrow": {
            "enum": [
              "solid",
              "dashed",
              "double"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    },
    "what": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_()-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label_it",
          "icon"
        ],
        "properties": {
          "label_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    }
  },
  "x-banco-table": {
    "name": "network/kinds",
    "track": "T4b",
    "used_by": [
      "network"
    ],
    "second_table": true
  }
}

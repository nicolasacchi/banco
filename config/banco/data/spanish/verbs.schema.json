{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:spanish-verbs",
  "title": "banco data table spanish/verbs",
  "description": "Every verb a Spanish lesson shows, with all six present forms (regular, stem-changing and irregular alike): this table is the truth, the engine only cross-checks. Each value carries its source; a second table typed separately by another session is compared by the unit test; changed only by a D entry (WAVE2 1.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "verbs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "verbs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_()-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meaning_it",
          "pattern",
          "forms",
          "source"
        ],
        "properties": {
          "meaning_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "pattern": {
            "enum": [
              "regular",
              "e-ie",
              "o-ue",
              "u-ue",
              "e-i",
              "go",
              "go-e-ie",
              "go-e-i",
              "irregular"
            ]
          },
          "forms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "yo",
              "tu",
              "el",
              "nosotros",
              "vosotros",
              "ellos"
            ],
            "properties": {
              "yo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "tu": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "el": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "nosotros": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "vosotros": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "ellos": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            }
          },
          "source": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "Where the value comes from (a book, a standard, a dataset with its year); required on every row (WAVE2 1.9)."
          }
        }
      }
    }
  },
  "x-banco-table": {
    "name": "spanish/verbs",
    "track": "T3",
    "used_by": [
      "paradigm persons",
      "words.present vectors"
    ],
    "second_table": true
  }
}

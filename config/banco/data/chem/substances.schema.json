{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:chem-substances",
  "title": "banco data table chem/substances",
  "description": "About 15 substances: melting and boiling points, specific heats in J/(g K), latent heats in J/g, the density flag and the boiling point by pressure; mixtures have ranges. Each value carries its source; a second table typed separately by another session is compared by the unit test; changed only by a D entry (WAVE2 1.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "substances"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "substances": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_()-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_it",
          "kind",
          "source"
        ],
        "properties": {
          "name_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "formula": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "kind": {
            "enum": [
              "pure",
              "mixture"
            ]
          },
          "mp_c": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "bp_c": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "c_solid": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "c_liquid": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "c_gas": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "latent_fusion": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "latent_vaporisation": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "solid_less_dense": {
            "type": "boolean"
          },
          "bp_by_pressure": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "atm",
                "bp_c"
              ],
              "properties": {
                "atm": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
                  "description": "An exact number as a string, decimal comma (lesson/num)."
                },
                "bp_c": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
                  "description": "An exact number as a string, decimal comma (lesson/num)."
                }
              }
            },
            "minItems": 1,
            "maxItems": 12
          },
          "boil_range_c": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
              "description": "An exact number as a string, decimal comma (lesson/num)."
            },
            "minItems": 2,
            "maxItems": 2
          },
          "source": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "Where the value comes from (a book, a standard, a dataset with its year); required on every row (WAVE2 1.9)."
          }
        }
      }
    }
  },
  "x-banco-table": {
    "name": "chem/substances",
    "track": "T7",
    "used_by": [
      "chart heating",
      "particles"
    ],
    "second_table": true
  }
}

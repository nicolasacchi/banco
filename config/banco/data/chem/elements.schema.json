{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:chem-elements",
  "title": "banco data table chem/elements",
  "description": "The 118 elements: atomic number, symbol (case-exact), Italian name, origin, group, period, category, state at 25 degrees C and mass. Each value carries its source; a second table typed separately by another session is compared by the unit test; changed only by a D entry (WAVE2 1.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "elements"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "elements": {
      "type": "array",
      "minItems": 118,
      "maxItems": 118,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "z",
          "symbol",
          "name_it",
          "group",
          "period",
          "category",
          "state_25c",
          "mass",
          "source"
        ],
        "properties": {
          "z": {
            "type": "integer",
            "minimum": 1,
            "maximum": 118
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "pattern": "^[A-Z][a-z]{0,2}$"
          },
          "name_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "origin_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "latin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "group": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 18
              },
              {
                "type": "null"
              }
            ]
          },
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "category": {
            "enum": [
              "alkali_metal",
              "alkaline_earth",
              "transition_metal",
              "post_transition_metal",
              "metalloid",
              "nonmetal",
              "halogen",
              "noble_gas",
              "lanthanide",
              "actinide",
              "unknown"
            ]
          },
          "state_25c": {
            "enum": [
              "solid",
              "liquid",
              "gas",
              "unknown"
            ]
          },
          "mass": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(,[0-9]+)?$",
            "description": "An exact number as a string, decimal comma (lesson/num)."
          },
          "source": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "Where the value comes from (a book, a standard, a dataset with its year); required on every row (WAVE2 1.9)."
          }
        }
      }
    }
  },
  "x-banco-table": {
    "name": "chem/elements",
    "track": "T7",
    "used_by": [
      "formula",
      "periodic_table",
      "E-CHEM-SYMBOL"
    ],
    "second_table": true
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:geo-names",
  "title": "banco data table geo/names",
  "description": "id to Italian name (the exonym rule): BRA is Brasile. T5 data shape, version 2 (D-T5).",
  "type": "object",
  "required": [
    "version",
    "generated_by",
    "names"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "generated_by": {
      "type": "string"
    },
    "names": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([A-Z]{3}|[a-z0-9]+(-[a-z0-9]+)*|[a-z]+(_[a-z]+)*)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "name_it",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "country",
              "territory",
              "continent",
              "ocean",
              "region",
              "city",
              "river"
            ]
          },
          "name_it": {
            "type": "string",
            "minLength": 1
          },
          "name_en": {
            "type": "string",
            "minLength": 1
          },
          "name_es": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "x-banco-table": {
    "name": "geo/names",
    "track": "T5",
    "used_by": [
      "map",
      "select checks"
    ],
    "second_table": true
  }
}

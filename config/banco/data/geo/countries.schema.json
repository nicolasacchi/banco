{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:geo-countries",
  "title": "banco data table geo/countries",
  "description": "Area and population with year and source, per ISO alpha-3 id. T5 data shape, version 2 (D-T5).",
  "type": "object",
  "required": [
    "version",
    "generated_by",
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "generated_by": {
      "type": "string"
    },
    "countries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "area_km2": {
            "type": "integer",
            "minimum": 1
          },
          "area_year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "area_source": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "integer",
            "minimum": 1
          },
          "population_year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "population_source": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependentRequired": {
          "area_km2": [
            "area_year",
            "area_source"
          ],
          "population": [
            "population_year",
            "population_source"
          ]
        }
      }
    }
  },
  "x-banco-table": {
    "name": "geo/countries",
    "track": "T5",
    "used_by": [
      "map",
      "checks"
    ],
    "second_table": true
  }
}

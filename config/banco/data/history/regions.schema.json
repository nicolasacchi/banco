{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "history/regions: the regions of the mediterraneo_antico base, composed from Natural Earth units (W2-D08)",
  "type": "object",
  "required": ["regions"],
  "additionalProperties": false,
  "properties": {
    "regions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]+(-[a-z]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name_it", "units", "why"],
        "additionalProperties": false,
        "properties": {
          "name_it": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 20 },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]{3}(/[^/@]+|@-?[0-9.]+,-?[0-9.]+,-?[0-9.]+,-?[0-9.]+)?$" }
          }
        }
      }
    }
  }
}

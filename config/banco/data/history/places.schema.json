{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:history-places",
  "title": "banco data table history/places",
  "description": "The mediterraneo_antico gazetteer: about 60 places (Pleiades) and 40 regions, each with its source (the Ancient World Mapping Center if its licence allows, else a named atlas page). T5 data shape, version 2 (D-T5).",
  "type": "object",
  "required": [
    "version",
    "dump",
    "licence",
    "places"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "dump": {
      "type": "string"
    },
    "licence": {
      "type": "string",
      "pattern": "CC BY 3.0"
    },
    "places": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]+(-[a-z]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name_it",
          "kind",
          "source",
          "pleiades",
          "pleiades_title",
          "lat",
          "lon"
        ],
        "additionalProperties": false,
        "properties": {
          "name_it": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "city",
              "battle",
              "river",
              "fortress",
              "frontier"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^Pleiades [0-9]+ \\(https://pleiades.stoa.org/places/[0-9]+\\), CC BY 3.0$"
          },
          "pleiades": {
            "type": "integer",
            "minimum": 1
          },
          "pleiades_title": {
            "type": "string",
            "minLength": 1
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      }
    }
  },
  "x-banco-table": {
    "name": "history/places",
    "track": "T5",
    "used_by": [
      "map mediterraneo_antico"
    ],
    "second_table": true
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banco:data:english-contractions",
  "title": "banco data table english/contractions",
  "description": "The contraction table: 'm, 're, 've, 'll and n't suffixes, whole words (won't, can't, let's, it's, I'd ...) with one or more readings, and the ambiguous 's and 'd after a noun, marked and never expanded (D-398). Each value carries its source (the table's `source` and the comments); a second table typed separately (english/contractions_expected) is compared by the unit test; changed only by a D entry (WAVE2 1.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "contractions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "contractions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short",
          "long"
        ],
        "properties": {
          "short": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "long": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "minItems": 1,
            "maxItems": 3
          },
          "ambiguous": {
            "type": "boolean"
          }
        }
      },
      "minItems": 10,
      "maxItems": 60
    }
  },
  "x-banco-table": {
    "name": "english/contractions",
    "track": "T3",
    "used_by": [
      "contractions option"
    ],
    "second_table": true
  }
}
